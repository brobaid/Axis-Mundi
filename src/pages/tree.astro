---
import BaseLayout from '../layouts/BaseLayout.astro';
import DetailPanel from '../components/DetailPanel.astro';
import TraditionSymbols from '../components/TraditionSymbols.astro';
import { getPublishable, getStructural } from '../lib/content';
import { TRADITIONS } from '../lib/traditions';
import {
  ROW_HEIGHT,
  TICK_FONT_SIZE,
  TICK_ROW_HEIGHT,
  layoutTree,
  treeDetents,
  type TreeNodeInput,
} from '../lib/tree-model';
import { eraLabel } from '../lib/map-render';

/**
 * The family tree (reference build's tree screen).
 *
 * Descent across all ten traditions, anchored to time where a record carries a
 * date. Every node on this page comes from the taxonomy; nothing is authored
 * here.
 */

const [taxonomy, dives, publishedTaxonomy] = await Promise.all([
  /* Structure only: ids, names, parents, contested flags, and the sourced
     founding and adherent blocks. */
  getStructural('taxonomy'),
  getPublishable('deepDives'),
  /* Prose gates separately from structure, as on the dive pages: a node whose
     summary is still awaiting a check keeps its place in the tree and says
     nothing. */
  getPublishable('taxonomy'),
]);

const hasDive = new Set<string>(dives.map((d) => d.data.tradition));
const proseOf = new Map(
  publishedTaxonomy.map((n) => [
    n.data.id,
    { summary: n.data.summary, editorialNote: n.data.editorial_note?.body },
  ]),
);

const input: TreeNodeInput[] = taxonomy.map((n) => ({
  id: n.data.id,
  name: n.data.name,
  parent: n.data.parent,
  tradition: n.data.tradition,
  path: n.data.path,
  depth: n.data.depth,
  contested: n.data.contested,
  foundedYear: n.data.founded.year,
  foundedDisplay: n.data.founded.display,
  foundedContested: n.data.founded.contested,
  adherentsDisplay: n.data.adherents?.display,
  adherentsContested: n.data.adherents?.contested ?? false,
  order: n.data.order,
  summary: proseOf.get(n.data.id)?.summary,
  editorialNote: proseOf.get(n.data.id)?.editorialNote,
}));

const WIDTH = 1000;
const layout = layoutTree(input, WIDTH, TRADITIONS.map((t) => t.id));
const detents = treeDetents(input);
const dated = input.filter((n) => n.foundedYear !== undefined).length;

const bootstrap = {
  nodes: layout.nodes.map((n) => ({
    id: n.id,
    name: n.name,
    tradition: n.tradition,
    path: n.path,
    depth: n.depth,
    contested: n.contested,
    dated: n.dated,
    foundedYear: n.foundedYear ?? null,
    foundedDisplay: n.foundedDisplay ?? null,
    foundedContested: n.foundedContested,
    adherentsDisplay: n.adherentsDisplay ?? null,
    adherentsContested: n.adherentsContested,
    hasDive: hasDive.has(n.tradition),
    summary: n.summary ?? null,
    editorialNote: n.editorialNote ?? null,
  })),
  rootYears: Object.fromEntries(
    input.filter((n) => n.depth === 1).map((n) => [n.tradition, n.foundedYear ?? null]),
  ),
  detents,
  traditionNames: Object.fromEntries(TRADITIONS.map((t) => [t.id, t.name])),
};
---

<BaseLayout
  title="Family tree"
  description="Descent across ten traditions and their branches, anchored to time where a founding record exists, with contested classifications shown rather than resolved."
>
  <TraditionSymbols />

  <section class="shell head">
    <p class="eyebrow">Room V · The Genealogy Room</p>
    <h1>Descent, branch by branch.</h1>
    <p class="crumb caption">
      <b>Family tree</b> · {input.length} nodes across {TRADITIONS.length} traditions · {dated} carry a
      founding date
    </p>
  </section>

  <div class="tree" data-tree>
    <!-- era slider -------------------------------------------------------- -->
    <div class="shell">
      <div class="scrub">
        <div class="scrub__rail" data-tree-scrubber role="radiogroup" aria-label="Era">
          <div class="scrub__line" aria-hidden="true"></div>
          <div class="meridian scrub__meridian" data-tree-meridian aria-hidden="true"></div>
          {
            detents.map((era, i) => (
              <button
                type="button"
                class:list={['scrub__detent', i === detents.length - 1 && 'scrub__detent--on']}
                data-era={era}
                role="radio"
                aria-checked={i === detents.length - 1}
                tabindex={i === detents.length - 1 ? 0 : -1}
              >
                <span class="scrub__tick" aria-hidden="true" />
                <span class="scrub__label">{eraLabel(era)}</span>
              </button>
            ))
          }
        </div>
        <p class="scrub__readout mono caption" data-tree-readout aria-live="polite"></p>
      </div>
    </div>

    <!-- the tree ---------------------------------------------------------- -->
    <div class="tree-scroll">
      <svg
        class="tree-svg"
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        preserveAspectRatio="xMinYMin meet"
        style={`--tree-ratio: ${layout.width} / ${layout.height}; --tick-size: ${TICK_FONT_SIZE}px`}
        role="img"
        aria-label={`Family tree of ${TRADITIONS.length} traditions and their branches`}
      >
        <g class="tree-axis" aria-hidden="true">
          <line x1="0" y1={layout.axisY} x2={layout.width} y2={layout.axisY} />
          {
            layout.ticks.map((t) => (
              <>
                <line x1={t.x} y1={0} x2={t.x} y2={layout.axisY} class="tree-axis__rule" />
                {/*
                  A stacked label is no longer beside its own rule, so a leader
                  carries the rule down to it. Without this the reader has to
                  guess which tick a label in the third row belongs to, which is
                  the overlap bug wearing a different hat.
                */}
                {t.row > 0 && (
                  <line
                    class="tree-axis__leader"
                    x1={t.x}
                    y1={layout.axisY}
                    x2={t.x}
                    y2={layout.axisY + t.row * TICK_ROW_HEIGHT + 3}
                  />
                )}
                <text x={t.x} y={layout.axisY + 11 + t.row * TICK_ROW_HEIGHT}>{t.label}</text>
              </>
            ))
          }
        </g>

        <g class="tree-edges" aria-hidden="true">
          {layout.edges.map((e) => <path d={e.path} />)}
        </g>

        <g class="tree-nodes">
          {
            layout.nodes.map((n) => (
              <g
                class:list={['tree-node', `tree-node--d${n.depth}`, !n.dated && 'tree-node--undated']}
                data-node={n.id}
                data-tradition={n.tradition}
                tabindex="0"
                role="button"
                aria-label={`${n.name}, ${n.path.split('/').join(' in ')}${n.contested ? ', contested classification' : ''}${n.foundedDisplay ? `, founded ${n.foundedDisplay}` : ', no founding record'}`}
                style={`--tradition-hue: var(--t-${n.tradition})`}
              >
                {/*
                  The row is the target, not the glyph. A node's own marks are
                  a 3–5px dot and an 11px line of text; the whole row band is
                  what a thumb can actually aim at, and the bands are
                  contiguous, so a tap in the tree always lands on some node
                  rather than on nothing.
                */}
                <rect
                  class="tree-node__hit"
                  x={0}
                  y={n.y - ROW_HEIGHT / 2}
                  width={layout.width}
                  height={ROW_HEIGHT}
                />
                <circle cx={n.x} cy={n.y} r={n.depth === 1 ? 5.5 : n.depth === 2 ? 4 : 3} />
                {/*
                  The contested ring sits before the name, not after it.

                  After it, its position had to be guessed from the character
                  count — and a proportional face does not have a per-character
                  width, so it drifted: measured, four of the five rings were
                  out by up to nineteen units, two of them landing inside their
                  own label. Before the name, it is a fixed offset from the node
                  dot and there is nothing left to estimate. It reads as a
                  margin mark, which is what it is.
                */}
                {n.contested && (
                  /*
                    A lozenge, not a second ring. Placed beside the node dot it
                    has to differ in shape as well as in colour, or a contested
                    node reads as a node with two dots — and an undated node's
                    own dot is already a hollow ring. The rotated square is the
                    house's small mark, the one the ornament uses.
                  */
                  <rect
                    class="tree-node__contested"
                    x={n.x + 12 - 3}
                    y={n.y - 3}
                    width={6}
                    height={6}
                    transform={`rotate(45 ${n.x + 12} ${n.y})`}
                  >
                    <title>Contested classification</title>
                  </rect>
                )}
                <text x={n.x + (n.contested ? 21 : 10)} y={n.y + 4}>{n.name}</text>
              </g>
            ))
          }
        </g>
      </svg>
    </div>

    <p class="shell tree-note measure">
      Horizontal position means a year only on the dated axis at the left, where the ten
      tradition nodes sit at their founding records. Every branch and denomination node is placed
      by descent instead, because no branch carries a founding date yet &mdash; their columns say
      &ldquo;descends from&rdquo;, never &ldquo;began in&rdquo;. A ringed node carries a contested
      classification and is placed by its own self-identification, per the standing rule.
    </p>

    <p class="shell caption tree-legend">
      The era slider dims what did not yet exist. A branch answers from its tradition&rsquo;s
      founding, since that is the only honest claim available: it cannot predate what it descends
      from.
    </p>
  </div>

  <DetailPanel />
</BaseLayout>

<script type="application/json" id="tree-data" set:html={JSON.stringify(bootstrap)} is:inline />

<script>
  import '../scripts/tree';
</script>

<style>
  .head {
    padding-block: var(--space-12) var(--space-4);
    max-width: 46rem;
  }

  .head h1 {
    font-size: clamp(2.125rem, 6vw, 2.875rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-block: var(--space-3) var(--space-3);
  }

  .crumb {
    color: var(--ink-soft);
  }

  /* --- era slider (the map's scrubber, same component vocabulary) -------- */

  .scrub {
    margin-block: var(--space-4) var(--space-6);
  }

  .scrub__rail {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-1);
    padding-top: var(--space-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .scrub__line {
    position: absolute;
    top: calc(var(--space-4) + 5px);
    left: 0;
    right: 0;
    height: var(--hairline-width);
    background: var(--hairline-strong);
  }

  .scrub__meridian {
    top: 0;
    bottom: 0;
    height: auto;
  }

  .scrub__detent {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: 0;
    padding: 0 var(--space-1);
    min-height: var(--tap-min);
    cursor: pointer;
    color: var(--ink-soft);
  }

  .scrub__tick {
    width: 11px;
    height: 11px;
    rotate: 45deg;
    border: 1.5px solid var(--hairline-strong);
    background: var(--canvas);
  }

  .scrub__detent--on .scrub__tick {
    border-color: var(--brass);
    background: var(--brass);
  }

  @media (hover: hover) {
    .scrub__detent:hover .scrub__tick {
      border-color: var(--brass);
    }
  }

  .scrub__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    white-space: nowrap;
  }

  .scrub__detent--on .scrub__label {
    color: var(--brass-ink);
  }

  .scrub__readout {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  /* --- the plate --------------------------------------------------------- */

  .tree-scroll {
    overflow-x: auto;
    border-block: var(--hairline-width) solid var(--hairline);
    background: var(--surface);
  }

  /* The box is reserved from the viewBox's own ratio, so the page does not
     jump when the drawing lands: `height: auto` alone left the browser to
     guess a replaced element's height and then correct it. */
  .tree-svg {
    display: block;
    min-width: 56rem;
    width: 100%;
    height: auto;
    aspect-ratio: var(--tree-ratio);
  }

  .tree-axis line {
    stroke: var(--hairline-strong);
    stroke-width: 1;
  }

  .tree-axis__rule {
    stroke: var(--hairline);
    stroke-width: 1;
  }

  /*
    The mono face is load-bearing here, not a style choice: the stacking in
    tree-model.ts computes each label's width from its character count, which
    is only true of a face whose glyphs all have one advance. The size comes
    from the same constant the model reserves room with, so the two cannot
    drift apart.
  */
  .tree-axis text {
    font-family: var(--font-mono);
    font-size: var(--tick-size);
    font-variant-numeric: tabular-nums;
    fill: var(--ink-soft);
    text-anchor: middle;
  }

  /* Carries a stacked label back to the tick it belongs to. */
  .tree-axis__leader {
    stroke: var(--hairline);
    stroke-width: 1;
  }

  .tree-edges path {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 1.2;
    opacity: 0.7;
  }

  .tree-node {
    cursor: pointer;
  }

  /* Transparent, but it takes the pointer — the glyphs above it do not need to. */
  .tree-node__hit {
    fill: transparent;
  }

  .tree-node circle {
    fill: var(--tradition-hue);
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  .tree-node text {
    font-family: var(--font-ui);
    font-size: 11px;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .tree-node--d1 text {
    font-size: 13px;
    font-weight: 600;
  }

  .tree-node--d3 text {
    font-size: 10.5px;
    fill: var(--ink-soft);
  }

  /* Placed by descent, not by date: hollow, so the eye can tell which nodes
     the axis actually speaks for. */
  .tree-node--undated circle {
    fill: var(--surface);
    stroke: var(--tradition-hue);
    stroke-width: 2;
  }

  .tree-node__contested {
    fill: var(--contested-hatch);
    stroke: none;
  }

  .tree-node:focus-within text {
    fill: var(--brass-ink);
  }

  @media (hover: hover) {
    .tree-node:hover text {
      fill: var(--brass-ink);
    }
  }

  /* Dimmed by the era slider: not yet in existence at the chosen year. */
  .tree-node[data-before] {
    opacity: 0.16;
  }

  .tree-note,
  .tree-legend {
    color: var(--ink-soft);
    padding-block: var(--space-4) 0;
  }

  .tree-legend {
    padding-bottom: var(--space-16);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tree-node {
      transition: opacity var(--dur-micro) var(--ease-out);
    }
  }
</style>
