---
import BaseLayout from '../layouts/BaseLayout.astro';
import TraditionSymbols from '../components/TraditionSymbols.astro';
import LandscapeHint from '../components/LandscapeHint.astro';
import DetailPanel from '../components/DetailPanel.astro';
import { getPublishable, includesUnsourced } from '../lib/content';
import { TRADITIONS } from '../lib/traditions';
import {
  DEFAULT_FRAME,
  detents,
  renderMap,
  type Geometry,
  type SiteMark,
  type SnapshotView,
} from '../lib/map-render';

/**
 * The map (M3).
 *
 * Twelve era snapshots (spec §6), each a hand-authored GeoJSON file. Pre-500
 * BCE is deliberately absent: the evidence is too thin to polygon honestly, so
 * the timeline carries that period and the map does not.
 */

const entries = await getPublishable('snapshots');

const snapshots: SnapshotView[] = entries
  .map((entry) => ({
    id: entry.data.id,
    era: entry.data.era,
    label: entry.data.label,
    fixture: entry.data.fixture,
    realms: entry.data.features.map((feature) => ({
      id: feature.properties.id,
      name: feature.properties.name,
      tradition: feature.properties.tradition,
      grade: feature.properties.grade,
      geometry: feature.geometry as Geometry,
      labelAnchor: feature.properties.label_anchor,
      labelCurve: feature.properties.label_curve,
      contested: feature.properties.contested,
    })),
  }))
  .sort((a, b) => a.era - b.era);

const available = new Set(snapshots.map((s) => s.era));
const rail = detents(available);
/* The latest delivered era, not the earliest. This was `snapshots[0]` while
   2020 was the only one, which read as "the present" by accident; with 1 CE
   delivered it would have landed the room in antiquity. The tree's slider
   opens on its last detent, and the two rooms share a cursor, so the map opens
   on its last delivered one. */
const activeEra = snapshots[snapshots.length - 1]?.era ?? 2020;

/* The owner's era notes, one per delivered snapshot, all rendered and all but
   the active one hidden — the island swaps them with the plate. */
const eraNotes = entries
  .map((entry) => ({ era: entry.data.era, label: entry.data.label, note: entry.data.era_note }))
  .filter((n): n is { era: number; label: string; note: string } => n.note !== undefined)
  .sort((a, b) => a.era - b.era);

/* Sacred sites — Phase 3 delighter B. Every site record with coordinates,
   drawn above every era fill and never scrubbed: a place is not a claim about
   an era. */
const siteEntries = await getPublishable('sites');
const sites: SiteMark[] = siteEntries.flatMap((e) =>
  e.data.location === undefined
    ? []
    : [{
        id: e.data.id,
        name: e.data.name,
        place: e.data.place,
        tradition: e.data.traditions[0] ?? 'unaffiliated',
        lat: e.data.location.lat,
        lng: e.data.location.lng,
      }],
);

const canvasHtml =
  snapshots.length === 0
    ? ''
    : renderMap(snapshots, DEFAULT_FRAME, {
        title: 'The World, by Era',
        activeEra,
        /* Renderable categories, not traditions: `unaffiliated` is a real
           majority in ten countries and needs its hatch pattern like the rest. */
        traditions: [...TRADITIONS.map((t) => t.id), 'unaffiliated'],
        traditionNames: Object.fromEntries(TRADITIONS.map((t) => [t.id, t.name])),
        sites,
      });

const sources = await getPublishable('sources');
const sourceTitles = Object.fromEntries(sources.map((s) => [s.data.id, s.data.title]));

const bootstrap = {
  snapshots: entries
    .map((entry) => ({
      id: entry.data.id,
      era: entry.data.era,
      label: entry.data.label,
      fixture: entry.data.fixture,
      realms: entry.data.features.map((f) => ({
        id: f.properties.id,
        name: f.properties.name,
        tradition: f.properties.tradition,
        grade: f.properties.grade,
        minorities: f.properties.minorities,
        sources: f.properties.sources,
        note: f.properties.note,
        contested: f.properties.contested,
        contested_note: f.properties.contested_note,
      })),
    }))
    .sort((a, b) => a.era - b.era),
  detents: rail,
  sourceTitles,
  /* Display names for the realm card. The raw id reads "chinese" where the
     tradition is "Chinese traditions". */
  traditionNames: Object.fromEntries(TRADITIONS.map((t) => [t.id, t.name])),
  /* Site cards, keyed by id, so a tap never waits on a fetch. */
  sites: Object.fromEntries(
    siteEntries.map((e) => [
      e.data.id,
      {
        name: e.data.name,
        place: e.data.place,
        tradition: e.data.traditions[0] ?? '',
        significance: e.data.significance,
        sources: e.data.sources,
      },
    ]),
  ),
};
---

<BaseLayout
  title="Map"
  description="An animated historical world map across twelve era snapshots, showing the dominant tradition per realm with an explicit confidence grade."
>
  <TraditionSymbols />

  <section class="shell head">
    <p class="eyebrow">Room III · The Atlas Room</p>
    <h1>The world, one era at a time.</h1>
    <p class="lede">
      Twelve snapshots, not an animation. Borders between them are never
      interpolated — an intermediate line would be a claim no source supports.
    </p>
    <div class="ornament" aria-hidden="true"><i></i><b></b><i></i></div>
  </section>

  <div class="shell">
    {
      snapshots.length === 0 ? (
        <p class="measure empty">
          No era snapshots have been published yet. The map renders from one GeoJSON file per
          snapshot year; the twelve years are locked by the spec, and the polygons come from the
          owner's research rather than from anything generated here.
        </p>
      ) : (
        <section class="map" data-map aria-label="Historical world map">
          <LandscapeHint room="map" line="The plate is a world map — turn the phone sideways to see it whole." />
          <p class="map-fixture-note" data-map-awaiting hidden>
            <span class="contested-badge">Not yet researched</span>
            This era has no snapshot. Its boundaries arrive as a sourced research memo from the
            owner; until then the plate stays empty rather than showing an invented one.
          </p>

          <div class="map-frame" data-map-canvas set:html={canvasHtml} />

          <!-- era scrubber ------------------------------------------- -->
          <div class="scrub">
            <div class="scrub__rail" data-scrubber role="radiogroup" aria-label="Era snapshot">
              <div class="scrub__line" aria-hidden="true" />
              <div class="meridian scrub__meridian" data-map-meridian aria-hidden="true" />
              {rail.map((d) => (
                <button
                  type="button"
                  class:list={['scrub__detent', !d.available && 'scrub__detent--empty']}
                  data-era={d.era}
                  role="radio"
                  aria-checked={d.era === activeEra}
                  tabindex={d.era === activeEra ? 0 : -1}
                  title={d.available ? d.label : `${d.label} — awaiting the owner's research memo`}
                >
                  <span class="scrub__tick" aria-hidden="true" />
                  <span class="scrub__label">{d.label}</span>
                </button>
              ))}
            </div>
            <p class="scrub__readout mono caption" data-map-readout aria-live="polite" />
          </div>

          <!-- sacred sites toggle ------------------------------------ -->
          {
            sites.length > 0 && (
              <p class="map-layers">
                <button
                  type="button"
                  class="map-layer-btn"
                  data-sites-toggle
                  aria-pressed="false"
                >
                  <span class="map-layer-btn__mark" aria-hidden="true" />
                  Sacred sites ({sites.length})
                </button>
                <span class="caption map-layers__note">
                  Landmarks, not realms: each stands on every plate, because a place is not a
                  claim about an era.
                </span>
              </p>
            )
          }

          <!-- era note ----------------------------------------------- -->
          {
            eraNotes.map((n) => (
              <aside
                class="era-note"
                data-era-note={n.era}
                hidden={n.era !== activeEra}
                aria-label={`What the ${n.label} snapshot does and does not show`}
              >
                <p class="eyebrow">Reading the {n.label} map</p>
                <p class="measure">{n.note}</p>
              </aside>
            ))
          }

          <!-- legend ------------------------------------------------- -->
          <div class="legend">
            <p class="eyebrow">Categories</p>
            <ul role="list">
              <li>
                <span class="legend__swatch legend__swatch--unaffiliated" aria-hidden="true" />
                Unaffiliated
              </li>
              <li>
                <span class="legend__swatch legend__swatch--outside" aria-hidden="true" />
                Outside this snapshot
              </li>
            </ul>
            <p class="caption">
              A realm shaded as unaffiliated is one the snapshot covers and answers: the
              religiously unaffiliated are its largest group. An unshaded one is outside the
              snapshot's scope. The two are never the same claim, and neither is hatched —
              hatching carries confidence, not secularity.
            </p>

            <p class="eyebrow legend__second">Confidence</p>
            <ul role="list">
              <li><span class="legend__swatch legend__swatch--a" aria-hidden="true" />A · documented</li>
              <li><span class="legend__swatch legend__swatch--b" aria-hidden="true" />B · scholarly estimate</li>
              <li><span class="legend__swatch legend__swatch--c" aria-hidden="true" />C · speculative</li>
            </ul>
            <p class="caption">
              Grade is rendered, never hidden: solid, reduced, hatched. A speculative realm looks
              speculative.
            </p>

            <p class="caption legend__note">
              Religiously unaffiliated is a Pew category, not a tradition; it renders in a neutral
              tone and is never hatched, because a secular majority is a documented fact, not an
              uncertain one.
            </p>
          </div>
        </section>
      )
    }

    <p class="caption build-note">
      {
        `${snapshots.length} of ${rail.length} era snapshots delivered. ` +
          (includesUnsourced
            ? 'This build includes records awaiting a source check.'
            : 'Records awaiting a source check are held out of this build.')
      }
    </p>
  </div>

  <DetailPanel />
</BaseLayout>

<script type="application/json" id="map-data" set:html={JSON.stringify(bootstrap)} is:inline />

<script>
  import '../scripts/map';
</script>

<style>
  .head {
    text-align: center;
    padding-block: var(--space-12) var(--space-2);
  }

  .head h1 {
    font-size: clamp(2.125rem, 5vw, 3.125rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: var(--space-3) auto;
    max-width: 20ch;
  }

  .lede {
    color: var(--ink-soft);
    max-width: 52ch;
    margin: 0 auto;
  }

  .ornament {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 520px;
    margin: 26px auto 30px;
  }

  .ornament i {
    flex: 1;
    height: 3px;
    border-top: var(--hairline-width) solid var(--hairline);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .ornament b {
    width: 5px;
    height: 5px;
    rotate: 45deg;
    background: var(--brass);
    flex: 0 0 auto;
  }

  .empty,
  .build-note {
    color: var(--ink-soft);
    padding-block: var(--space-6);
  }

  .map-fixture-note {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--size-small);
    color: var(--ink-soft);
    max-width: var(--measure);
    margin-bottom: var(--space-4);
  }

  /* --- the plate --------------------------------------------------------- */

  /* The chip is positioned against this box, so the room is its own
     coordinate space. */
  .map {
    position: relative;
  }

  .map-frame {
    background: var(--land);
    border: var(--hairline-width) solid var(--ink);
    box-shadow:
      0 0 0 3px var(--canvas),
      0 0 0 4px var(--hairline);
  }

  .map-frame :global(.map-svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .map-frame :global(.map-ocean) {
    fill: var(--ocean);
  }

  /* Land the snapshot does not shade. Not decoration and not emptiness: at an
     era where the ten traditions cover a minority of the world, this tone is
     everyone else. It never takes a pointer — only shaded realms answer. */
  .map-frame :global(.map-land path) {
    fill: var(--land);
    stroke: var(--hairline-strong);
    stroke-width: 0.3;
    stroke-opacity: 0.45;
    pointer-events: none;
  }

  .map-frame :global(.map-graticule line) {
    stroke: var(--hairline-strong);
    stroke-width: 0.5;
    opacity: 0.5;
  }

  /* Snapshots crossfade on opacity alone — never shape-tweened (§7). */
  .map-frame :global(.map-snapshot) {
    transition: opacity var(--dur-scrub) var(--ease-standard);
  }

  /* opacity:0 still takes clicks. Without this an inactive layer sits over the
     visible one and a realm tap opens the wrong era's card. Tied to aria-hidden
     so the pointer and the accessibility tree can never disagree. */
  .map-frame :global(.map-snapshot[aria-hidden='true']) {
    pointer-events: none;
  }

  .map-frame :global(.map-realm) {
    cursor: pointer;
  }

  .map-frame :global(.map-realm__fill) {
    stroke-width: 0.75;
    transition: opacity var(--dur-micro) var(--ease-out);
  }

  /* Confidence grades (design language §3.3). */
  .map-frame :global(.map-realm--a .map-realm__fill) {
    fill-opacity: 0.82;
  }

  .map-frame :global(.map-realm--b .map-realm__fill) {
    fill-opacity: 0.5;
  }

  .map-frame :global(.map-realm--c .map-realm__fill) {
    fill-opacity: 1;
    stroke-dasharray: 3 2;
  }

  .map-frame :global(.map-realm:focus-within .map-realm__fill) {
    fill-opacity: 1;
  }

  @media (hover: hover) {
    .map-frame :global(.map-realm:hover .map-realm__fill) {
      fill-opacity: 1;
    }
  }

  /* Curved lettering with a paper halo, so a name stays legible over hatching. */
  .map-frame :global(.map-label) {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--ink);
    stroke: var(--land);
    stroke-width: 3.5;
    paint-order: stroke fill;
    pointer-events: none;
  }

  /* --- atlas furniture --------------------------------------------------- */

  .map-frame :global(.map-cartouche__plate) {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1;
  }

  .map-frame :global(.map-cartouche__inner) {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 0.75;
  }

  .map-frame :global(.map-cartouche__title) {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    fill: var(--ink);
  }

  .map-frame :global(.map-cartouche__era) {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--brass-ink);
  }

  .map-frame :global(.map-cartouche__fixture) {
    font-family: var(--font-ui);
    font-size: 7.5px;
    letter-spacing: 0.18em;
    fill: var(--contested-badge-ink);
  }

  /* --- sacred sites (Phase 3 delighter B) ------------------------------- */

  /* An engraved settlement mark, not a pin: an open ring with a centre point,
     the way a plate atlas marks a place that is simply there. */
  .map-frame :global(.map-site__ring) {
    fill: var(--surface);
    stroke-width: 1.4;
    opacity: 0.95;
  }

  .map-frame :global(.map-site__hit) {
    fill: transparent;
  }

  .map-frame :global(.map-site__count) {
    font-family: var(--font-mono);
    font-size: 7px;
    fill: var(--ink);
  }

  /* The cluster chooser, in the shared panel. */
  :global(.map-site-list) {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-1);
  }

  :global(.map-site-row) {
    width: 100%;
    text-align: left;
    padding: var(--space-2) 0;
    background: transparent;
    border: 0;
    border-bottom: var(--hairline-width) solid var(--hairline);
    color: var(--ink);
    font-size: var(--size-small);
    cursor: pointer;
  }

  .map-frame :global(.map-site) {
    cursor: pointer;
  }

  .map-frame :global(.map-site:focus-visible) {
    outline: none;
  }

  .map-frame :global(.map-site:focus-visible .map-site__hit) {
    fill: none;
    stroke: var(--focus-ring);
    stroke-width: 2;
  }

  .map-layers {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
  }

  .map-layer-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    border: var(--hairline-width) solid var(--hairline);
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    cursor: pointer;
  }

  .map-layer-btn[aria-pressed='true'] {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--surface);
  }

  /* The same mark the plate draws, at button scale. */
  .map-layer-btn__mark {
    width: 10px;
    height: 10px;
    border: 1.4px solid var(--brass);
    border-radius: 50%;
    background: var(--surface);
    flex: none;
  }

  .map-layers__note {
    color: var(--ink-soft);
    flex: 1 1 16rem;
  }

  .map-frame :global(.map-compass__ring),
  .map-frame :global(.map-compass__cross) {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1;
    opacity: 0.75;
  }

  .map-frame :global(.map-compass__needle) {
    fill: var(--brass);
    opacity: 0.5;
    stroke: var(--brass);
    stroke-width: 1;
  }

  .map-frame :global(.map-compass__n) {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    fill: var(--brass-ink);
  }

  .map-frame :global(.map-frame-outer),
  .map-frame :global(.map-frame-inner) {
    fill: none;
    stroke: var(--ink);
  }

  .map-frame :global(.map-frame-outer) {
    stroke-width: 2;
  }

  .map-frame :global(.map-frame-inner) {
    stroke-width: 0.75;
    opacity: 0.6;
  }

  /* --- scrubber ---------------------------------------------------------- */

  .scrub {
    margin-top: var(--space-6);
  }

  .scrub__rail {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-1);
    padding-top: var(--space-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .scrub__line {
    position: absolute;
    top: calc(var(--space-4) + 5px);
    left: 0;
    right: 0;
    height: var(--hairline-width);
    background: var(--hairline-strong);
  }

  /* The Brass Meridian, the same object as on the timeline. */
  .scrub__meridian {
    top: 0;
    bottom: 0;
    height: auto;
  }

  .scrub__detent {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: 0;
    padding: 0 var(--space-1);
    min-height: var(--tap-min);
    cursor: pointer;
    color: var(--ink-soft);
  }

  .scrub__detent[disabled] {
    cursor: default;
    opacity: 0.4;
  }

  .scrub__tick {
    width: 11px;
    height: 11px;
    rotate: 45deg;
    border: 1.5px solid var(--hairline-strong);
    background: var(--canvas);
  }

  .scrub__detent--on .scrub__tick {
    border-color: var(--brass);
    background: var(--brass);
  }

  @media (hover: hover) {
    .scrub__detent:not([disabled]):hover .scrub__tick {
      border-color: var(--brass);
    }
  }

  .scrub__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    white-space: nowrap;
  }

  .scrub__detent--on .scrub__label {
    color: var(--brass-ink);
  }

  .scrub__readout {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  /* --- tap-resolution chip (touch only) ----------------------------------- */

  /* Built by the island at runtime, so these selectors are global: a node the
     compiler never saw carries no scope attribute.

     A country is as big as its geography, so the 44px rule cannot be met by
     growing the target. It is met by resolving the tap instead: the nearest
     realm within a fingertip is offered here, magnified, and nothing opens
     until the reader taps it. A stray thumb that opened Belgium would be worse
     than a small country that takes two taps. */
  :global(.map-chip) {
    position: absolute;
    z-index: var(--z-sheet);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: var(--hairline-width) solid var(--ink);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-panel);
    text-align: left;
    cursor: pointer;
    animation: chip-in var(--dur-micro) var(--ease-out);
  }

  /* The magnifier. Square so the outline is never stretched, and sized so an
     eleven-pixel country becomes something a thumb can judge. */
  :global(.map-chip__shape) {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    overflow: visible;
  }

  :global(.map-chip__text) {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  :global(.map-chip__text b) {
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }

  :global(.map-chip__text i) {
    font-style: normal;
    font-family: var(--font-ui);
    font-size: 11.5px;
    color: var(--ink-soft);
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.map-chip) {
      animation: none;
    }
  }

  /* --- era note ----------------------------------------------------------- */

  /* Sits between the scrubber and the legend: you choose an era, then read what
     that era's plate does and does not claim, then learn how to read its
     shading. The brass rule marks it as the owner's own words rather than the
     interface's. */
  .era-note {
    margin-block: var(--space-6) 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--brass);
  }

  .era-note p:last-child {
    margin-block-start: var(--space-2);
    color: var(--ink-soft);
  }

  /* --- legend ------------------------------------------------------------ */

  .legend {
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: var(--hairline-width) solid var(--hairline);
  }

  .legend ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    font-family: var(--font-ui);
    font-size: var(--size-caption);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

