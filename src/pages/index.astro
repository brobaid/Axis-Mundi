---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAxis from '../components/HeroAxis.astro';
import RoomPlaque from '../components/RoomPlaque.astro';
import TraditionSymbols from '../components/TraditionSymbols.astro';
import { getPublishable } from '../lib/content';
import OnThisDay from '../components/OnThisDay.astro';

/**
 * The entrance hall (reference build's home screen).
 *
 * Three things and no more: the axis, the four doors, and the curator's
 * account of what this is.
 *
 * There used to be a fourth — a static preview strip of the timeline, which
 * was the entrance's hero before the axis was built and went on rendering
 * beneath it afterwards, so the hall had two. One hero. The strip's model
 * (`src/lib/hero-strip.ts`) went with it rather than sitting unused.
 */

/* A door only opens onto a page that exists in this build. Deep dives are gated
   behind their own sourcing, so in production that door stays shut and says
   what it is waiting for rather than leading to a 404. */
const dives = await getPublishable('deepDives');

interface Door {
  eyebrow: string;
  title: string;
  blurb: string;
  href: string | undefined;
  waitingOn?: string;
}

const doors: Door[] = [
  {
    eyebrow: 'Explore',
    title: 'Timeline',
    blurb: 'Every tradition on one canvas. Zoom from millennia to decades.',
    href: '/timeline',
  },
  {
    eyebrow: 'Explore',
    title: 'Map',
    blurb: 'Watch belief move across regions, era by era.',
    href: '/map',
  },
  {
    eyebrow: 'Read',
    title: 'Deep dives',
    blurb: 'Ten traditions, one identical structure, fully sourced.',
    href: dives.length === 0 ? undefined : '/traditions',
    waitingOn: 'Waiting on the first source-checked dive.',
  },
  {
    eyebrow: 'Compare',
    title: 'Belief matrix',
    blurb: 'Filter every tradition by what it holds.',
    href: '/matrix',
  },
];

---

<BaseLayout
  title="Axis Mundi"
  description="An interactive comparative reference for ten religious traditions: timeline, historical map, deep dives and belief matrix."
>
  <TraditionSymbols />

  <section class="shell hero">
    <div class="hero__plaque">
      <RoomPlaque
        lede="Timelines, maps and deep dives across ten traditions, drawn from academic sources, presented without a thumb on the scale."
      />
    </div>
    <HeroAxis />
  </section>

  <!--
    First visit only, then never.

    The site was built in the open and reads as though you watched it happen:
    the rooms have Roman numerals, the nav has eight names, and nothing on the
    entrance says what any of them answers. Three lines and four doors, in the
    house voice, on the first visit and no other.

    Same storage rule as the timeline's coach, which the design language allows
    because this is not a reading path: everything it says is true of the museum
    whether or not it ever appeared, and with storage refused it simply greets
    each visit rather than breaking anything.
  -->
  <div class="orient" data-orient hidden>
    <div class="orient__card" role="dialog" aria-labelledby="orient-title" aria-modal="false">
      <p class="eyebrow" id="orient-title">First time here</p>
      <ol class="orient__lines" role="list">
        <li>Ten traditions, described to the same depth and in the same words.</li>
        <li>Every claim is sourced and says so; where scholars disagree, both positions stand.</li>
        <li>Nothing is ranked, scored, or recommended.</li>
      </ol>
      <p class="eyebrow orient__doors-label">Four doors</p>
      <ul class="orient__doors" role="list">
        <li><a href="/timeline"><b>When did things happen</b><span>the Timeline</span></a></li>
        <li><a href="/map"><b>Where</b><span>the Map</span></a></li>
        <li><a href="/matrix"><b>What do they believe</b><span>the Matrix</span></a></li>
        <li><a href="/traditions"><b>Each tradition whole</b><span>the Dives</span></a></li>
      </ul>
      <button type="button" class="orient__dismiss" data-orient-dismiss>Look around</button>
    </div>
  </div>

  <OnThisDay />

  <!-- The four doors ------------------------------------------------------ -->
  <section class="shell doors" aria-label="Rooms">
    {
      doors.map((door) =>
        door.href === undefined ? (
          <div class="door door--shut">
            <span class="eyebrow">{door.eyebrow}</span>
            <h3>{door.title}</h3>
            <p>{door.blurb}</p>
            <p class="door__waiting caption">{door.waitingOn}</p>
          </div>
        ) : (
          <a class="door" href={door.href}>
            <span class="eyebrow">{door.eyebrow}</span>
            <h3>{door.title}</h3>
            <p>{door.blurb}</p>
          </a>
        ),
      )
    }
  </section>

  <!-- Curator's copy ------------------------------------------------------ -->
  <section class="shell curator">
    <div class="ornament" aria-hidden="true"><i></i><b></b><i></i></div>
    <p>
      Axis Mundi describes what ten traditions hold and practise. It does not evaluate them.
      Supernatural claims are attributed uniformly &mdash; &ldquo;according to Sunni
      tradition&rdquo; carries the same temperature as &ldquo;according to Theravada
      accounts&rdquo; &mdash; and each tradition&rsquo;s own terminology comes first, with
      translation alongside.
    </p>
    <p>
      Where scholarship disagrees, the disagreement is shown rather than resolved: a badge, a
      note, and citations for both positions. Where a record has not yet passed a source check,
      it is held out of the build rather than published unsourced. That is why some rooms here
      are emptier than they will be.
    </p>
    <p class="curator__more">
      <a class="tap" href="/methodology">How this reference is built &rarr;</a>
    </p>
  </section>
</BaseLayout>

<script>
  import '../scripts/orientation';
</script>

<style>
  /* --- hero --------------------------------------------------------------- */

  .hero {
    padding-block: var(--space-12) var(--space-2);
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  /*
    Two columns once there is room for two, and the plaque keeps its own measure
    inside its column so the name never stretches to meet the wheel.
  */
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      gap: var(--space-16);
      align-items: center;
    }
  }

  .hero__plaque {
    max-width: 46rem;
  }

  /* The grid's gap is the whole distance to the wheel; the plaque's own bottom
     margin would stack on top of it and open a hole at 390px. */
  .hero__plaque :global(.plaque) {
    margin-bottom: 0;
  }

  /*
    The title settles in once, on first paint, and never again.

    A fade and a short rise — opacity and transform, nothing that could move the
    layout — on the whole plaque rather than line by line, because a staggered
    entrance is a performance and this is a wall label.
  */
  .hero__plaque {
    animation: hero-settle 900ms var(--ease-out) both;
  }

  @keyframes hero-settle {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The fade only: the rise is motion, the fade is a dissolve. */
  @media (prefers-reduced-motion: reduce) {
    .hero__plaque {
      animation: hero-fade 600ms var(--ease-out) both;
    }

    @keyframes hero-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* --- first-visit orientation ------------------------------------------- */

  /*
    The same furniture as the timeline's coach — a scrim, a card, a dismiss —
    because it is the same kind of thing and the museum should only have one of
    them. The doors are the four rooms a first-time visitor most needs named,
    in the owner's own words, each paired with the question it answers.
  */
  .orient {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: end center;
    padding: var(--space-6) var(--space-4);
    background: var(--scrim);
  }

  @media (min-width: 48rem) {
    .orient {
      place-items: center;
    }
  }

  .orient__card {
    width: min(32rem, 100%);
    max-height: 100%;
    overflow-y: auto;
    background: var(--surface);
    border: var(--hairline-width) solid var(--ink);
    box-shadow: var(--shadow-panel);
    padding: var(--space-6);
  }

  .orient__lines {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 var(--space-6);
    display: grid;
    gap: var(--space-2);
  }

  .orient__lines li {
    font-size: var(--size-small);
    padding-left: var(--space-4);
    position: relative;
  }

  /* The house's small mark, doing the job a bullet would. */
  .orient__lines li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 4px;
    rotate: 45deg;
    background: var(--brass);
  }

  .orient__doors-label {
    margin-bottom: var(--space-2);
  }

  .orient__doors {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: grid;
    gap: var(--space-1);
  }

  .orient__doors a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding: var(--space-2) 0;
    border-bottom: var(--hairline-width) solid var(--hairline);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--size-small);
  }

  .orient__doors b {
    font-weight: 400;
  }

  .orient__doors span {
    flex: none;
    font-family: var(--font-ui);
    color: var(--brass-ink);
  }

  .orient__doors a:hover b {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .orient__dismiss {
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    border: var(--hairline-width) solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    cursor: pointer;
  }

  .orient__dismiss:hover {
    background: var(--brass-wash);
  }

  .hero h1 {
    font-size: clamp(2.125rem, 7vw, 2.875rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-block: var(--space-3) var(--space-3);
  }

  .lede {
    color: var(--ink-soft);
    max-width: 52ch;
  }


  /* --- doors -------------------------------------------------------------- */

  .doors {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .door {
    display: block;
    background: var(--surface);
    border: var(--hairline-width) solid var(--hairline);
    padding: var(--space-4) var(--space-3);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) {
    a.door:hover {
      border-color: var(--brass);
    }
  }

  .door h3 {
    font-size: var(--size-h3);
    margin-block: var(--space-1) var(--space-1);
  }

  .door p {
    font-size: var(--size-caption);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .door--shut {
    border-style: dashed;
  }

  .door--shut h3 {
    color: var(--ink-soft);
  }

  .door__waiting {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--hairline-width) solid var(--hairline);
    color: var(--brass-ink);
  }

  /* --- curator ------------------------------------------------------------ */

  .curator {
    max-width: 46rem;
    padding-block: var(--space-12) var(--space-16);
  }

  .curator p {
    max-width: var(--measure);
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }

  .curator__more a {
    font-family: var(--font-ui);
    font-size: var(--size-small);
  }

</style>
