---
import BaseLayout from '../layouts/BaseLayout.astro';
import TraditionSymbols from '../components/TraditionSymbols.astro';
import { TRADITIONS } from '../lib/traditions';
import { getPublishable } from '../lib/content';
import { heroLanes, heroWindow, heroYear, position, type HeroEvent } from '../lib/hero-strip';
import OnThisDay from '../components/OnThisDay.astro';

/**
 * The entrance hall (reference build's home screen).
 *
 * Three things and no more: the living timeline, the four doors, and the
 * curator's account of what this is. The foundation exhibits that stood here
 * through M0 — the token specimen, the pipeline ledger, the launch-ten roll —
 * were scaffolding for a build with nothing else to show. The timeline, the
 * map and the matrix are real now, so the ledger moved to the methodology page
 * where a reader goes to ask how the thing is made.
 */

const events = await getPublishable('events');

/* One dot per tradition per event: a multi-tradition record genuinely belongs
   in both lanes, exactly as it does on the timeline itself. */
const heroEvents: HeroEvent[] = events.flatMap((entry) =>
  entry.data.traditions.map((tradition) => ({
    year: entry.data.year_start,
    tradition,
    importance: entry.data.importance,
  })),
);

const window = heroWindow(heroEvents);
const lanes = heroLanes(heroEvents, TRADITIONS, window);

/* The meridian marks the middle of the window. A time cursor points at a year,
   not at a claim, so it carries no assertion about what happened there. */
const meridianYear = Math.round((window.from + window.to) / 2);
const meridianAt = position(meridianYear, window);

/* The axis names its two extents and nothing between them. Intermediate marks
   would have to be absolutely positioned and centred, and at 390px the last two
   collide — while the faint century rules already carry the interval, and the
   meridian names the one year in the middle. An axis with its ends labelled is
   also simply the plate convention. */
const columns = Math.max(1, Math.round((window.to - window.from) / 100));

/* The real span of the records, which is not the axis: the window rounds out to
   whole centuries so the strip reads as an axis rather than as the extremes of
   whatever happens to be sourced this week. */
const years = heroEvents.map((e) => e.year);
const firstYear = years.length === 0 ? window.from : Math.min(...years);
const lastYear = years.length === 0 ? window.to : Math.max(...years);

/* A door only opens onto a page that exists in this build. Deep dives are gated
   behind their own sourcing, so in production that door stays shut and says
   what it is waiting for rather than leading to a 404. */
const dives = await getPublishable('deepDives');

interface Door {
  eyebrow: string;
  title: string;
  blurb: string;
  href: string | undefined;
  waitingOn?: string;
}

const doors: Door[] = [
  {
    eyebrow: 'Explore',
    title: 'Timeline',
    blurb: 'Every tradition on one canvas. Zoom from millennia to decades.',
    href: '/timeline',
  },
  {
    eyebrow: 'Explore',
    title: 'Map',
    blurb: 'Watch belief move across regions, era by era.',
    href: '/map',
  },
  {
    eyebrow: 'Read',
    title: 'Deep dives',
    blurb: 'Ten traditions, one identical structure, fully sourced.',
    href: dives.length === 0 ? undefined : '/traditions',
    waitingOn: 'Waiting on the first source-checked dive.',
  },
  {
    eyebrow: 'Compare',
    title: 'Belief matrix',
    blurb: 'Filter every tradition by what it holds.',
    href: '/matrix',
  },
];

const eventCount = events.length;
const traditionsWithEvents = new Set(heroEvents.map((e) => e.tradition)).size;
---

<BaseLayout
  title="Axis Mundi"
  description="An interactive comparative reference for ten religious traditions: timeline, historical map, deep dives and belief matrix."
>
  <TraditionSymbols />

  <section class="shell hero">
    <p class="eyebrow">A comparative reference for the world&rsquo;s religions</p>
    <h1>Five thousand years of belief, on one line.</h1>
    <p class="lede">
      Timelines, maps and deep dives across ten traditions, drawn from academic sources,
      presented without a thumb on the scale.
    </p>
  </section>

  <!-- The living timeline ------------------------------------------------- -->
  <div class="strip-wrap">
    <section class="strip" aria-labelledby="strip-heading" style={`--strip-cols:${columns}`}>
      <h2 id="strip-heading" class="visually-hidden">Timeline preview</h2>

      <div class="strip__lanes">
        {
          lanes.map((lane, laneIndex) => (
            <div class="strip__lane" style={`--tradition-hue: var(--t-${lane.tradition})`}>
              <span class="visually-hidden">
                {lane.name}: {lane.dots.length} events in this build
              </span>
              {lane.dots.map((dot, dotIndex) => (
                <i
                  class={`strip__dot strip__dot--r${dot.importance}`}
                  style={`left:${dot.x.toFixed(2)}%; --enter-delay:${(6 - dot.importance) * 30 + laneIndex * 20 + (dotIndex % 5) * 12}ms`}
                  aria-hidden="true"
                />
              ))}
            </div>
          ))
        }
        <div
          class="meridian strip__meridian"
          style={`left:${meridianAt.toFixed(2)}%`}
          aria-hidden="true"
        >
        </div>
        <b class="strip__year mono" style={`left:${meridianAt.toFixed(2)}%`} aria-hidden="true">
          {heroYear(meridianYear)}
        </b>
      </div>

      <div class="strip__axis" aria-hidden="true">
        <span class="mono">{heroYear(window.from)}</span>
        <span class="mono">{heroYear(window.to)}</span>
      </div>
    </section>

    <p class="strip__caption shell caption">
      {eventCount} source-checked events across {traditionsWithEvents} of {TRADITIONS.length}
      traditions, {heroYear(firstYear)} to {heroYear(lastYear)}.
      {
        /* This sentence existed because Sikhism's lane was empty. Every lane
           carries events now, so it earns its place only if one empties again. */
        traditionsWithEvents < TRADITIONS.length &&
          ' An empty lane is a tradition whose events are still awaiting a source check, not a tradition without a history.'
      }
    </p>

    <!-- Only when a record can answer today's date. -->
    <OnThisDay />
  </div>

  <!-- The four doors ------------------------------------------------------ -->
  <section class="shell doors" aria-label="Rooms">
    {
      doors.map((door) =>
        door.href === undefined ? (
          <div class="door door--shut">
            <span class="eyebrow">{door.eyebrow}</span>
            <h3>{door.title}</h3>
            <p>{door.blurb}</p>
            <p class="door__waiting caption">{door.waitingOn}</p>
          </div>
        ) : (
          <a class="door" href={door.href}>
            <span class="eyebrow">{door.eyebrow}</span>
            <h3>{door.title}</h3>
            <p>{door.blurb}</p>
          </a>
        ),
      )
    }
  </section>

  <!-- Curator's copy ------------------------------------------------------ -->
  <section class="shell curator">
    <div class="ornament" aria-hidden="true"><i></i><b></b><i></i></div>
    <p>
      Axis Mundi describes what ten traditions hold and practise. It does not evaluate them.
      Supernatural claims are attributed uniformly &mdash; &ldquo;according to Sunni
      tradition&rdquo; carries the same temperature as &ldquo;according to Theravada
      accounts&rdquo; &mdash; and each tradition&rsquo;s own terminology comes first, with
      translation alongside.
    </p>
    <p>
      Where scholarship disagrees, the disagreement is shown rather than resolved: a badge, a
      note, and citations for both positions. Where a record has not yet passed a source check,
      it is held out of the build rather than published unsourced. That is why some rooms here
      are emptier than they will be.
    </p>
    <p class="curator__more">
      <a class="tap" href="/methodology">How this reference is built &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* --- hero --------------------------------------------------------------- */

  .hero {
    max-width: 46rem;
    padding-block: var(--space-12) var(--space-2);
  }

  .hero h1 {
    font-size: clamp(2.125rem, 7vw, 2.875rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin-block: var(--space-3) var(--space-3);
  }

  .lede {
    color: var(--ink-soft);
    max-width: 52ch;
  }


  /* --- the living timeline ------------------------------------------------ */

  .strip-wrap {
    margin-top: var(--space-8);
  }

  .strip {
    position: relative;
    max-width: 61.25rem;
    margin-inline: auto;
    background: var(--surface);
    border-block: var(--hairline-width) solid var(--hairline);
    overflow: hidden;
  }

  .strip__lanes {
    position: relative;
    padding-block: var(--space-4);
    /* The lane rhythm from the reference build: a faint column grid behind the
       dots so the strip reads as an axis rather than as scattered marks. One
       rule per century of the window, so the grid means something — a column is
       a hundred years — rather than dividing the plate into an arbitrary twelve. */
    background-image: repeating-linear-gradient(
      to right,
      transparent 0 calc(100% / var(--strip-cols) - 1px),
      var(--hairline) calc(100% / var(--strip-cols) - 1px) calc(100% / var(--strip-cols))
    );
  }

  .strip__lane {
    position: relative;
    height: 22px;
  }

  .strip__dot {
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tradition-hue);
    translate: -50% -50%;
    /* Events enter by importance rank (design language §7). */
    animation: dot-in var(--dur-panel) var(--ease-out) backwards;
    animation-delay: var(--enter-delay, 0ms);
  }

  /* Rank drives size, as it does on the timeline canvas. */
  .strip__dot--r5 {
    width: 9px;
    height: 9px;
  }

  .strip__dot--r3 {
    width: 6px;
    height: 6px;
  }

  @keyframes dot-in {
    from {
      opacity: 0;
      scale: 0.4;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .strip__meridian {
    top: 0;
    bottom: 0;
    height: auto;
  }

  .strip__year {
    position: absolute;
    top: var(--space-1);
    translate: -50% 0;
    background: var(--brass);
    color: var(--ink-inverse);
    font-size: 10px;
    font-weight: 500;
    padding: 2px var(--space-2);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .strip__axis {
    display: flex;
    justify-content: space-between;
    padding: var(--space-1) var(--space-2);
    border-top: var(--hairline-width) solid var(--hairline);
    font-size: 10px;
    color: var(--ink-soft);
  }

  .strip__caption {
    display: block;
    margin-top: var(--space-3);
    max-width: 52rem;
  }

  /* --- doors -------------------------------------------------------------- */

  .doors {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .door {
    display: block;
    background: var(--surface);
    border: var(--hairline-width) solid var(--hairline);
    padding: var(--space-4) var(--space-3);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) {
    a.door:hover {
      border-color: var(--brass);
    }
  }

  .door h3 {
    font-size: var(--size-h3);
    margin-block: var(--space-1) var(--space-1);
  }

  .door p {
    font-size: var(--size-caption);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .door--shut {
    border-style: dashed;
  }

  .door--shut h3 {
    color: var(--ink-soft);
  }

  .door__waiting {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--hairline-width) solid var(--hairline);
    color: var(--brass-ink);
  }

  /* --- curator ------------------------------------------------------------ */

  .curator {
    max-width: 46rem;
    padding-block: var(--space-12) var(--space-16);
  }

  .curator p {
    max-width: var(--measure);
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }

  .curator__more a {
    font-family: var(--font-ui);
    font-size: var(--size-small);
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__dot {
      animation: none;
    }
  }
</style>
