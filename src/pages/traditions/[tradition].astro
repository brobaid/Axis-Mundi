---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TraditionSymbols from '../../components/TraditionSymbols.astro';
import TraditionSymbol from '../../components/TraditionSymbol.astro';
import GlossaryCard from '../../components/GlossaryCard.astro';
import MatrixCells from '../../components/MatrixCells.astro';
import DevotionalToggle from '../../components/DevotionalToggle.astro';
import Ornament from '../../components/Ornament.astro';
import OrnamentDefs from '../../components/OrnamentDefs.astro';
import { ORNAMENTS } from '../../lib/ornaments';
import { getPublishable, getStructural, includesUnsourced } from '../../lib/content';
import { renderProse, termsFor } from '../../lib/prose';
import { applyHonorifics } from '../../lib/devotional';
import { traditionMeta } from '../../lib/traditions';
import type { MatrixDimension } from '../../schemas/matrix';
import { displayDate } from '../../lib/display-date';

/**
 * The deep-dive template — Phase 0 spec §5.
 *
 * Fourteen sections, identical order for all ten traditions. The order never
 * bends per tradition, because comparability is the product feature (§1.3);
 * a section with nothing published yet keeps its heading and says so, rather
 * than vanishing and changing the shape of the page.
 */

export const getStaticPaths = (async () => {
  const dives = await getPublishable('deepDives');
  return dives.map((entry) => ({
    params: { tradition: entry.data.tradition },
    props: { dive: entry.data },
  }));
}) satisfies GetStaticPaths;

const { dive } = Astro.props;
const meta = traditionMeta(dive.tradition);
const kit = ORNAMENTS[dive.tradition];

const [glossary, taxonomy, publishedTaxonomy, matrixRows, festivals, siteRecords, figureRecords, sources, events, texts, works, shelfRows] = await Promise.all([
  getPublishable('glossary'),
  /* The branch tree renders names and contested flags — spec §2.3 structure. */
  getStructural('taxonomy'),
  /* Currents carry authored summaries, so they gate on sourcing. */
  getPublishable('taxonomy'),
  getPublishable('matrix'),
  getPublishable('festivals'),
  getPublishable('sites'),
  getPublishable('figures'),
  getPublishable('sources'),
  getPublishable('events'),
  getPublishable('texts'),
  /* A canon row links into the Reading Room when that text is in the build. */
  getPublishable('works'),
  /* And to its waiting-on row when it is only on the acquisition plan. */
  getPublishable('shelf'),
]);

/* §5.1 stat box: founding and principal text are extracted, never authored
   here. The founding lives on the tradition's taxonomy node — structural, like
   adherents, because it is sourced in its own right — and the principal text is
   the `primary` record in the texts collection. */
const founded = taxonomy.find((n) => n.data.id === dive.tradition && n.data.depth === 1)?.data
  .founded;
const primaryText = texts.find((t) => t.data.tradition === dive.tradition && t.data.primary);

/* Branches and calendar are extracted too. The branch list is the taxonomy's own
   depth-2 children in their declared order; the calendar is the matrix's
   calendar-system cell, which carries its own source. */
const branchesSummary = taxonomy
  .filter((n) => n.data.tradition === dive.tradition && n.data.depth === 2)
  .sort((a, b) => a.data.order - b.data.order)
  .map((n) => n.data.name)
  .join(' · ');

const calendarCell = matrixRows
  .find((r) => r.data.node === dive.tradition)
  ?.data.cells.find((c) => c.dimension === 'calendar-system');

const available = new Set(glossary.map((g) => g.data.id));
/* Headwords this tradition holds as technical terms. A dive's prose is about
   one tradition, so that is the only vocabulary the matcher may offer. */
const autoTerms = termsFor(
  [dive.tradition],
  glossary.map((g) => ({ id: g.data.id, term: g.data.term, traditions: g.data.traditions })),
);
/*
  Prose, then the devotional marks over it.

  The honorific runs last and over already-escaped HTML, and it only ever wraps
  — the sentence a scholar sourced is on the page byte for byte with the frame
  off, because with the frame off the span it added renders nothing.
*/
const prose = (body: string): string =>
  applyHonorifics(renderProse(body, { available, autoTerms }), dive.tradition);

/** A prose block renders only when it has passed a source check. */
const publishable = <T extends { sourcing: 'sourced' | 'todo' | 'editorial' } | undefined>(
  block: T,
): T | undefined =>
  block === undefined ? undefined : includesUnsourced || block.sourcing !== 'todo' ? block : undefined;

/* §5.5 Branches — the taxonomy under this tradition, to three levels. */
const branches = taxonomy
  .filter((n) => n.data.tradition === dive.tradition && n.data.depth === 2)
  .sort((a, b) => a.data.order - b.data.order)
  .map((family) => ({
    node: family.data,
    children: taxonomy
      .filter((n) => n.data.parent === family.data.id)
      .sort((a, b) => a.data.order - b.data.order)
      .map((c) => c.data),
  }));

const traditionNode = publishedTaxonomy.find((n) => n.data.id === dive.tradition)?.data;
const currents = traditionNode?.currents ?? [];

/* §5.3 and §5.7 — matrix cells, extracted not rewritten (§1.2). */
const row = matrixRows.find((r) => r.data.node === dive.tradition);
const cellsFor = (dimensions: readonly MatrixDimension[]) =>
  dimensions
    .map((d) => row?.data.cells.find((c) => c.dimension === d))
    .filter((c): c is NonNullable<typeof c> => c !== undefined);

const beliefCells = cellsFor(dive.belief_dimensions);
const lawCells = cellsFor(dive.law_dimensions);

/* §5.9 Holy days */
const holyDays = dive.festivals
  .map((id) => festivals.find((f) => f.data.id === id)?.data)
  .filter((f): f is NonNullable<typeof f> => f !== undefined);

/* §5.10 and §5.11 — the dive names its sites and figures by id; the records
   themselves live in their own collections, which the map layer and the
   influence network will read too. Both gate on their own sourcing. */
const sacredSites = dive.sites
  .map((id) => siteRecords.find((s) => s.data.id === id)?.data)
  .filter((s): s is NonNullable<typeof s> => s !== undefined);

const keyFigures = dive.figures
  .map((id) => figureRecords.find((f) => f.data.id === id)?.data)
  .filter((f): f is NonNullable<typeof f> => f !== undefined);

/* §5.8 — rites, in the life arc's own order rather than the record order. */
const RITE_ORDER = ['birth', 'childhood', 'coming-of-age', 'marriage', 'death'] as const;
const rites = [...dive.rites]
  .filter((r) => includesUnsourced || r.sourcing !== 'todo')
  .sort((a, b) => RITE_ORDER.indexOf(a.stage) - RITE_ORDER.indexOf(b.stage));

/* §5.2 — events for the period marker, and the pre-filtered timeline link. */
const traditionEvents = events
  .filter((e) => e.data.traditions.includes(dive.tradition))
  .sort((a, b) => a.data.year_start - b.data.year_start);

/* §5.14 — everything cited anywhere on the page, plus further reading. */
const citedIds = new Set<string>([
  ...dive.further_reading,
  ...[dive.overview, dive.origins, dive.core_beliefs, dive.law_and_ethics, dive.demographics]
    .filter((b) => b !== undefined)
    .flatMap((b) => b!.sources),
  ...dive.canon.flatMap((c) => c.sources),
  ...dive.practices.flatMap((p) => p.sources),
  ...dive.misconceptions.flatMap((m) => m.sources),
]);
const cited = sources.filter((s) => citedIds.has(s.data.id));

const SECTIONS = [
  { id: 'overview', label: 'Overview' },
  { id: 'origins', label: 'Origins and history' },
  { id: 'beliefs', label: 'Core beliefs' },
  { id: 'texts', label: 'Sacred texts' },
  { id: 'branches', label: 'Branches' },
  { id: 'practices', label: 'Practices and worship' },
  { id: 'law', label: 'Law and ethics' },
  { id: 'rites', label: 'Rites of passage' },
  { id: 'holy-days', label: 'Holy days' },
  { id: 'sites', label: 'Sacred sites' },
  { id: 'figures', label: 'Key figures' },
  { id: 'demographics', label: 'Demographics' },
  { id: 'misconceptions', label: 'Common misconceptions' },
  { id: 'sources', label: 'Sources and further reading' },
];

const overview = publishable(dive.overview);
const origins = publishable(dive.origins);
const beliefs = publishable(dive.core_beliefs);
const law = publishable(dive.law_and_ethics);
const demographics = publishable(dive.demographics);
const canon = dive.canon.filter((c) => includesUnsourced || c.sourcing !== 'todo');
/* Canon rows whose text has entered the Reading Room, by shared id. */
const readable = new Set(works.map((w) => w.data.id));
/* And rows the Reading Room has a plan for but not yet a text: those link to
   the row that says what it is waiting on, which is a more useful answer than
   no link at all — "coming" is information, and so is "no clean English
   exists". A canon nobody has a plan for stays unlinked, because inventing one
   would be the museum promising something it has not undertaken. */
const planned = new Map<string, { id: string; partly: boolean }>(
  shelfRows.flatMap((r) =>
    r.data.canon_ids.map(
      (id) => [id, { id: r.data.id, partly: r.data.partly_live.length > 0 }] as const,
    ),
  ),
);
const practices = dive.practices.filter((p) => includesUnsourced || p.sourcing !== 'todo');
const misconceptions = dive.misconceptions.filter((m) => includesUnsourced || m.sourcing !== 'todo');

/* Seven of the ten display strings already carry their year; repeating it read
   as "2.3 bn (Pew, 2020) (2020)". The two census figures do not, and there the
   year is the only thing telling the reader the count is a decade old. */
const adherentYear = dive.stat_box.adherents?.year;
const showAdherentYear =
  adherentYear !== undefined && !dive.stat_box.adherents?.display.includes(String(adherentYear));
---

<BaseLayout
  tradition={dive.tradition}
  title={dive.name}
  description={`${dive.name}: ${dive.subtitle}. Structured deep dive across beliefs, texts, branches, practice and demographics.`}
>
  <TraditionSymbols />

  <article class="shell dd">
    <OrnamentDefs tradition={dive.tradition} />
    {/* The field, behind everything and fixed: a courtyard does not scroll. */}
    <div class="dd-world" aria-hidden="true">
      <Ornament tradition={dive.tradition} piece="pattern" />
    </div>
    <!-- masthead ------------------------------------------------------- -->
    <!--
      The header band is where the room's theme lives: a tinted paper, the
      tradition's pattern tile behind it at whisper opacity, a corner motif at
      each end, and the once-only mark where the kit carries one. Everything
      below this band is the museum's standing paper and ink.
    -->
    <header class="dd-mast" style={`--tradition-hue: var(${meta.hueToken})`}>
      {/* Layer one: the field, deepening upward like light falling into a
          courtyard. Layer two: the tradition's pattern across it. Layer three:
          the corner work. The name is set over all three. */}
      <div class="dd-mast__field" aria-hidden="true"></div>
      <Ornament tradition={dive.tradition} piece="pattern" class="dd-mast__weave" />
      <div class="dd-mast__corners" aria-hidden="true">
        <Ornament tradition={dive.tradition} piece="corner" size={64} />
        <Ornament tradition={dive.tradition} piece="corner" size={64} class="dd-mast__corner--end" />
      </div>
      <div class="dd-mast__body">
        <div class="dd-mast__id">
          <TraditionSymbol tradition={dive.tradition} size={40} />
          {kit.mark && <Ornament tradition={dive.tradition} piece="mark" size={26} class="dd-mast__mark" />}
          {
            /* Sikhism's mark is calligraphy rather than geometry: Ik Onkar set
               once in the Gurmukhi face the reading room already carries. */
            dive.tradition === 'sikhism' && (
              <span class="dd-mast__onkar" lang="pa" aria-hidden="true">
                ੴ
              </span>
            )
          }
        </div>
        {
          dive.original && (
            <div class="dd-mast__script" lang={dive.original.lang} dir="rtl">
              {dive.original.text}
            </div>
          )
        }
        <h1>{dive.name}</h1>
        {/* Jainism's record carries an empty subtitle; an empty <p> in a band
            is a hole in the wall rather than a line of text. */}
        {(dive.subtitle ?? '').trim() !== '' && <p class="dd-mast__sub">{dive.subtitle}</p>}
      </div>
    </header>

    <DevotionalToggle tradition={dive.tradition} />

    <!-- §5.1 exhibit-label stat box ------------------------------------ -->
    <dl class="exhibit-label dd-stats">
      {
        dive.stat_box.adherents && (
          <>
            <dt>Adherents</dt>
            <dd>
              {dive.stat_box.adherents.display}
              {showAdherentYear && ` (${adherentYear})`}
              {/* An unsourced figure says so. A cited one does not: the citation
                  stands in the Sources section below. */}
              {!dive.stat_box.adherents.source && <span class="dd-pending"> · unverified</span>}
              {dive.stat_box.adherents.contested && <span class="contested-badge">Contested</span>}
            </dd>
          </>
        )
      }
      {
        founded?.display && (
          <>
            <dt>Founded</dt>
            <dd>
              {founded.display}
              {founded.contested && <span class="contested-badge">Contested</span>}
            </dd>
          </>
        )
      }
      {
        primaryText && (
          <>
            <dt>Primary text</dt>
            <dd>
              {primaryText.data.title}
              {primaryText.data.contested && <span class="contested-badge">Contested</span>}
            </dd>
          </>
        )
      }
      {
        branchesSummary && (
          <>
            <dt>Branches</dt>
            <dd>{branchesSummary}</dd>
          </>
        )
      }
      {
        calendarCell && (
          <>
            <dt>Calendar</dt>
            <dd>{calendarCell.label ?? calendarCell.value}</dd>
          </>
        )
      }
    </dl>

    <!-- sticky section nav --------------------------------------------- -->
    <nav class="dd-nav" aria-label="Sections">
      {SECTIONS.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>

    <!-- 1 ------------------------------------------------------------- -->
    <section id="overview" class="dd-section dd-section--first">
      <h2>Overview</h2>
      {overview ? <Fragment set:html={prose(overview.body)} /> : <p class="dd-pending">Awaiting a source check.</p>}
    </section>

    <!-- 2 ------------------------------------------------------------- -->
    <section id="origins" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Origins and history</h2>
      {
        dive.origins_period && (
          <p class="dd-period mono">
            {displayDate({
              year_start: dive.origins_period.from,
              year_end: dive.origins_period.to,
              precision: dive.origins_period.precision,
            })}
          </p>
        )
      }
      {origins ? <Fragment set:html={prose(origins.body)} /> : <p class="dd-pending">Awaiting a source check.</p>}
      <p>
        <a class="tap" href={`/timeline?drill=${dive.tradition}`}>
          Open the timeline, filtered to {dive.name} &rarr;
        </a>
        <span class="caption"> · {traditionEvents.length} events in this build</span>
      </p>
    </section>

    <!-- 3 ------------------------------------------------------------- -->
    <section id="beliefs" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Core beliefs</h2>
      {beliefs ? <Fragment set:html={prose(beliefs.body)} /> : <p class="dd-pending">Awaiting a source check.</p>}
      {beliefCells.length > 0 && <MatrixCells cells={beliefCells} />}
    </section>

    <!-- 4 ------------------------------------------------------------- -->
    <section id="texts" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Sacred texts</h2>
      {
        canon.length === 0 ? (
          <p class="dd-pending">Awaiting a source check.</p>
        ) : (
          <div class="table-scroll">
            <table class="canon">
              <thead>
                <tr>
                  <th scope="col">Text</th>
                  <th scope="col">Language</th>
                  <th scope="col">Composition</th>
                  <th scope="col">Canonical status</th>
                </tr>
              </thead>
              <tbody>
                {canon.map((c) => (
                  <tr>
                    <th scope="row">
                      {/* The row is the claim about the text; the link is the
                          text itself once it is in the build, and until then
                          the row in the Reading Room that says what the
                          museum is waiting on. */}
                      {readable.has(c.id) ? (
                        <a class="canon__read" href={`/read/${c.id}`}>
                          {c.title}
                          <span class="canon__read-mark caption"> · read</span>
                        </a>
                      ) : planned.has(c.id) ? (
                        <a
                          class="canon__read canon__read--soon"
                          href={`/read#${planned.get(c.id)!.id}`}
                        >
                          {c.title}
                          {/* A shelf can be partly live: the Dhammapada is
                              here and the rest of the Pali Canon is not, and
                              "being acquired" would be false of the half a
                              reader can already open. */}
                          <span class="canon__read-mark caption">
                            {planned.get(c.id)!.partly ? ' · partly here' : ' · being acquired'}
                          </span>
                        </a>
                      ) : (
                        c.title
                      )}
                      {c.original && (
                        <span class="canon__script" lang={c.original.lang} dir="rtl">
                          {c.original.text}
                        </span>
                      )}
                    </th>
                    <td>{c.language}</td>
                    <td class="mono">
                      {c.composition}
                      {c.contested && <span class="contested-badge">Contested</span>}
                    </td>
                    <td>
                      {c.status}
                      {/* Spec §9.2.3: a contested row cites both positions. */}
                      {c.contested && c.contested_note && (
                        <span class="canon__note caption">{c.contested_note}</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    <!-- 5 ------------------------------------------------------------- -->
    <section id="branches" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Branches</h2>
      {
        branches.length === 0 ? (
          <p class="dd-pending">No branch records in this build.</p>
        ) : (
          <ul class="tree" role="list">
            {branches.map(({ node, children }) => (
              <li>
                <span class="tree__family">
                  {node.name}
                  {node.contested && <span class="contested-badge">Contested</span>}
                </span>
                {children.length > 0 && (
                  <ul role="list">
                    {children.map((c) => (
                      <li>
                        {c.name}
                        {c.contested && <span class="contested-badge">Contested</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )
      }
      {
        currents.length > 0 && (
          <div class="dd-currents">
            <p class="eyebrow">Currents</p>
            <p class="caption">
              Movements that cut across branches rather than forming one. They are never rendered
              as lanes or branches.
            </p>
            <ul role="list">
              {currents.map((c) => (
                <li>
                  <b>{c.name}</b> — {c.summary}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    <!-- 6 ------------------------------------------------------------- -->
    <section id="practices" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Practices and worship</h2>
      {
        practices.length === 0 ? (
          <p class="dd-pending">Awaiting a source check.</p>
        ) : (
          <ul class="dd-list" role="list">
            {practices.map((p) => (
              <li>
                <b>{p.name}</b>
                {p.frequency && <span class="caption"> · {p.frequency}</span>}
                <p>{p.summary}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- 7 ------------------------------------------------------------- -->
    <section id="law" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Law and ethics</h2>
      {law ? <Fragment set:html={prose(law.body)} /> : null}
      {
        lawCells.length > 0 ? (
          <MatrixCells cells={lawCells} />
        ) : (
          !law && <p class="dd-pending">Awaiting a source check.</p>
        )
      }
    </section>

    <!-- 8 ------------------------------------------------------------- -->
    <section id="rites" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Rites of passage</h2>
      {
        rites.length === 0 ? (
          <p class="dd-pending">Life-arc records land in Phase 3.</p>
        ) : (
          <ul class="dd-list" role="list">
            {rites.map((r) => (
              <li>
                <b>{r.name}</b> <span class="caption">· {r.stage.replaceAll('-', ' ')}</span>
                <p>{r.summary}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- 9 ------------------------------------------------------------- -->
    <section id="holy-days" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Holy days</h2>
      {
        holyDays.length === 0 ? (
          <p class="dd-pending">Awaiting a source check.</p>
        ) : (
          <ul class="dd-list" role="list">
            {holyDays.map((f) => (
              <li>
                <b>{f.name}</b> <span class="caption">· {f.calendar}</span>
                <p>{f.date_rule}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- 10 ------------------------------------------------------------ -->
    <section id="sites" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Sacred sites</h2>
      {
        sacredSites.length === 0 ? (
          <p class="dd-pending">Site records land with the map, in Phase 2.</p>
        ) : (
          <ul class="dd-list" role="list">
            {sacredSites.map((s) => (
              <li>
                <b>{s.name}</b>
                {s.place && <span class="caption">· {s.place}</span>}
                <p>{s.significance}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- 11 ------------------------------------------------------------ -->
    <section id="figures" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Key figures</h2>
      {
        keyFigures.length === 0 ? (
          <p class="dd-pending">Figure records land with the influence network, in Phase 4.</p>
        ) : (
          <ul class="dd-list" role="list">
            {keyFigures.map((f) => (
              <li>
                <b>{f.name}</b>
                {f.born && (
                  <span class="caption mono">
                    {' · '}
                    {/* "b." only where the record says the person is living;
                        a missing death date does not mean one. */}
                    {f.living && 'b. '}
                    {displayDate({ year_start: f.born.year, precision: f.born.precision })}
                    {f.died && ' – '}
                    {f.died && displayDate({ year_start: f.died.year, precision: f.died.precision })}
                    {/* A date the tradition gives and scholarship does not is
                        never rendered as if the museum were asserting it. */}
                    {f.dates_note && ` (${f.dates_note})`}
                  </span>
                )}
                {f.contested && <span class="contested-badge">Contested</span>}
                <p>{f.summary}</p>
                {f.contested && f.contested_note && (
                  <p class="dd-note caption">{f.contested_note}</p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- 12 ------------------------------------------------------------ -->
    <section id="demographics" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Demographics</h2>
      {
        demographics ? (
          <Fragment set:html={prose(demographics.body)} />
        ) : (
          <p class="dd-pending">
            Country-level figures follow Pew Research and land when the sourced file does.
          </p>
        )
      }
    </section>

    <!-- 13 ------------------------------------------------------------ -->
    <section id="misconceptions" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Common misconceptions</h2>
      <p class="caption measure">
        These correct factual errors only. Theological disagreements between traditions, or within
        one, are not misconceptions and are not treated as such.
      </p>
      {
        misconceptions.length === 0 ? (
          <p class="dd-pending">Awaiting a source check.</p>
        ) : (
          misconceptions.map((m) => (
            <div class="miscon">
              {kit.frame && (
                <Ornament tradition={dive.tradition} piece="frame" class="miscon__arch" />
              )}
              <p class="eyebrow">Misconception</p>
              <p class="miscon__claim">&ldquo;{m.claim}&rdquo;</p>
              <p>{m.correction}</p>
              {m.sources.length > 0 && (
                <p class="caption mono">
                  Source: {m.sources.map((s) => sources.find((x) => x.data.id === s)?.data.title ?? s).join(', ')}
                </p>
              )}
            </div>
          ))
        )
      }
    </section>

    <!-- 14 ------------------------------------------------------------ -->
    <section id="sources" class="dd-section">
      <Ornament tradition={dive.tradition} piece="divider" class="dd-rule" />
      <h2>Sources and further reading</h2>
      {
        cited.length === 0 ? (
          <p class="dd-pending">No sources cited on this page yet.</p>
        ) : (
          <ul class="dd-list" role="list">
            {cited.map((s) => (
              <li>
                <b>{s.data.title}</b>
                {s.data.author && <span> — {s.data.author}</span>}
                {s.data.publisher && <span class="caption"> · {s.data.publisher}</span>}
                <span class="mono caption"> · {s.data.tier}</span>
                {s.data.tier === 'T4' && <span class="caption"> · tradition-internal</span>}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </article>

  <GlossaryCard />
</BaseLayout>

<style>
  /* The band opens the page, so the dive keeps a smaller top margin than the
     other rooms: 48px of empty canvas above a full-width band leaves it
     floating rather than hung. */
  .dd {
    padding-block: var(--space-6) var(--space-8);
    max-width: 60rem;
  }

  /* --- the world --------------------------------------------------------- */

  /*
    A dive is not a page with a themed header; it is a room.

    The field runs edge to edge behind everything, fixed rather than scrolled,
    because a courtyard does not slide away when you read. The tradition's own
    pattern lies across it at atmosphere strength — present enough to be felt,
    never enough to be hunted for — and every panel of text floats on top.

    The tokens under all of this are the museum's own, re-cut per tradition in
    tokens.css, which is what lets every one of the 186 contrast contracts hold
    inside each of the ten. `--world` is the single token that never carries
    text, and the token gate asserts that separately.
  */
  .dd-world {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--world);
    pointer-events: none;
  }

  /*
    The pattern on the field needs the field's own ink, not the panel's.

    `--th-pattern` is cut to sit on paper; laid on a deep field at 5% it is
    invisible, which is not atmosphere, it is nothing. The field's weave is the
    band's light ink instead, at an opacity chosen to be felt rather than read.
  */
  .dd-world :global(.orn--pattern) {
    color: var(--band-ink);
    opacity: 0.09;
  }

  /* --- the gate ----------------------------------------------------------- */

  /*
    The header band: full bleed, layered, the tradition's name set into it like
    an inscription cut into a gate rather than a title typed above a page.

    Three layers under the lettering — a gradient of the field deepening
    upward, the pattern woven across it at a stronger opacity than the room's
    atmosphere, and the corner work at each end. The lettering itself is the
    one text this museum sets on a deep field, so it has its own ink token and
    its own contrast checks at both ends of the gradient.
  */
  .dd-mast {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 15rem;
    margin-bottom: var(--space-8);
    padding: var(--space-12) var(--space-4) var(--space-8);
    /* Out past the shell to the viewport's own edges. */
    margin-inline: calc(50% - 50vw);
    padding-inline: max(var(--space-4), calc(50vw - 30rem + var(--space-4)));
    overflow: hidden;
  }

  @media (min-width: 48rem) {
    .dd-mast {
      min-height: 20rem;
      padding-block: var(--space-16) var(--space-12);
    }
  }

  .dd-mast__field {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, var(--world-deep), var(--world) 68%, var(--world));
  }

  /* The gate is where the pattern is read as pattern rather than felt as air. */
  .dd-mast .dd-mast__weave {
    z-index: 0;
    color: var(--band-ink);
    opacity: 0.16;
  }

  /*
    The corner work, at the scale a gate wants rather than a card's.
    Cropped by the band's own overflow, so it reads as carved into the corner
    rather than sitting in it.
  */
  .dd-mast__corners {
    position: absolute;
    inset: var(--space-4) var(--space-4) auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 1;
    pointer-events: none;
    color: var(--band-ink);
    opacity: 0.42;
  }

  @media (min-width: 48rem) {
    .dd-mast__corners {
      inset: var(--space-6) var(--space-8) auto;
    }
  }

  .dd-mast__corner--end {
    transform: scaleX(-1);
  }

  .dd-mast__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--band-ink);
  }

  .dd-mast h1 {
    color: var(--band-ink);
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .dd-mast__sub {
    color: var(--band-ink-soft);
    font-size: var(--size-h3);
    max-width: 44ch;
  }

  /* The symbol, the once-only mark, and Ik Onkar where that is the mark.
     Sacred emblems keep their scale: once, small, in the header. */
  .dd-mast__id {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .dd-mast__mark {
    color: var(--band-ink);
  }

  .dd-mast__onkar {
    font-family: var(--font-gurmukhi);
    font-size: 30px;
    line-height: 1;
    color: var(--band-ink);
  }

  .dd-mast__script {
    font-family: var(--font-arabic);
    font-size: 40px;
    line-height: 1.3;
    color: var(--band-ink-soft);
    align-self: start;
    width: fit-content;
  }

  /* --- section nav ------------------------------------------------------ */

  /*
    The section rail is a panel too, and that is structural rather than
    decorative: nothing focusable in a dive sits on the bare field. A focus ring
    cannot clear 3:1 against both a near-white panel and a mid-tone field —
    Jainism's marble on stone is exactly that pair — so the guarantee is that a
    control is never on the field to begin with.
  */
  .dd-nav {
    position: sticky;
    top: 60px;
    margin-top: var(--space-6);
    z-index: 10;
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    background: var(--canvas);
    border: var(--hairline-width) solid var(--hairline-strong);
    border-radius: var(--radius-s);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-6);
    scrollbar-width: thin;
  }

  /* The stat box and the devotional toggle float on the world too. */
  .dd-stats,
  :global(.dd .dv-toggle) {
    background: var(--canvas);
    border: var(--hairline-width) solid var(--hairline-strong);
    border-radius: var(--radius-s);
    padding: var(--space-4);
  }

  .dd-nav a {
    flex: 0 0 auto;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
  }

  @media (hover: hover) {
    .dd-nav a:hover {
      background: var(--surface);
      color: var(--brass-ink);
    }
  }

  /* --- sections --------------------------------------------------------- */

  /*
    The section divider is the tradition's own figure on the rule, in place of
    the neutral hairline every other room uses. It is drawn rather than
    bordered because a border cannot carry a quatrefoil.
  */
  /*
    A panel floating on the world.

    This is the non-negotiable half of the brief made structural: everything a
    reader reads sits on `--canvas`, which is the museum's paper tinted toward
    the tradition and no further than legibility allows, and every one of the
    186 contrast contracts is re-run against it per theme. The world is behind
    the panel and never under a word of prose.
  */
  .dd-section {
    position: relative;
    background: var(--canvas);
    border: var(--hairline-width) solid var(--hairline-strong);
    border-radius: var(--radius-s);
    padding: var(--space-6) var(--space-4);
    margin-bottom: var(--space-6);
    scroll-margin-top: 120px;
  }

  @media (min-width: 48rem) {
    .dd-section {
      padding: var(--space-8);
    }
  }

  .dd-section--first {
    padding-top: var(--space-6);
  }

  @media (min-width: 48rem) {
    .dd-section--first {
      padding-top: var(--space-8);
    }
  }

  /* Section headings in the theme's vocabulary: the tradition's own metal. */
  .dd-section h2 {
    color: var(--brass-ink);
    margin-bottom: var(--space-4);
  }

  /* The divider opens the panel rather than separating two of them, so it sits
     under the heading it belongs to. */
  .dd-rule {
    margin-bottom: var(--space-6);
    opacity: 0.9;
  }

  .dd-section h2 {
    margin-bottom: var(--space-3);
  }

  .dd-section :global(p) {
    max-width: var(--measure);
    margin-bottom: var(--space-3);
  }

  .dd-period {
    color: var(--brass-ink);
    font-size: var(--size-caption);
  }

  /* --- canon table ------------------------------------------------------ */

  .table-scroll {
    overflow-x: auto;
  }

  .canon {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-small);
    min-width: 34rem;
  }

  .canon th,
  .canon td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .canon thead th {
    font-family: var(--font-ui);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 600;
    white-space: nowrap;
  }

  .canon__read {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline-strong);
  }

  /* A text that is coming is not a text you can read, so the link is set
     dashed: the same affordance, visibly provisional. */
  .canon__read--soon {
    text-decoration-style: dashed;
  }

  .canon__read-mark {
    color: var(--ink-soft);
    text-decoration: none;
    display: inline-block;
  }

  .canon__script {
    font-family: var(--font-arabic);
    color: var(--ink-soft);
    margin-left: var(--space-2);
  }

  /* Both positions, under the status they qualify. */
  .canon__note,
  .dd-note {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  /* --- branch tree ------------------------------------------------------ */

  .tree,
  .tree ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tree > li {
    padding-block: var(--space-2);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .tree__family {
    font-family: var(--font-ui);
    font-size: var(--size-small);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tree ul {
    padding-left: var(--space-4);
    margin-top: var(--space-1);
  }

  .tree ul li {
    font-size: var(--size-caption);
    color: var(--ink-soft);
    padding-block: 2px;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dd-currents {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--surface);
    border: var(--hairline-width) solid var(--hairline);
  }

  .dd-currents ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
    font-size: var(--size-small);
  }

  .dd-currents li {
    padding-block: var(--space-1);
  }

  /* --- lists and misconceptions ----------------------------------------- */

  .dd-list {
    list-style: none;
    padding: 0;
  }

  .dd-list li {
    padding-block: var(--space-3);
    border-bottom: var(--hairline-width) solid var(--hairline);
    font-size: var(--size-small);
  }

  .dd-list li :global(p) {
    margin: var(--space-1) 0 0;
    color: var(--ink-soft);
  }

  /*
    The quoted claim, framed in the room's own hand.

    This is the dive's blockquote — the one place a dive sets someone else's
    words in quotation marks — so it is what the kit's frame treatment applies
    to. The frame is the border and the rule, never the fill: the card keeps
    `--surface` and `--ink` so the correction underneath reads at the same
    contrast it does in every other room.
  */
  .miscon {
    position: relative;
    border: var(--hairline-width) solid var(--hairline-strong);
    border-left: 3px solid var(--brass);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    background: var(--surface);
  }

  .miscon__claim {
    font-family: var(--font-display);
    font-size: var(--size-h3);
  }

  /*
    Christianity's frame is a gothic arch — the one tradition whose table names
    a shape for this. It is struck behind the card's top edge as line, not as a
    clipping path, so no text is ever pushed out of the box by an ornament.
  */
  .miscon__arch {
    position: absolute;
    inset-inline: -1px;
    top: -1px;
    height: 46px;
    z-index: 0;
    opacity: 0.5;
  }

  .miscon > :global(*) {
    position: relative;
    z-index: 1;
  }

  /* --- link accents ----------------------------------------------------- */

  /*
    Nothing here.

    Links used to be re-coloured on the dive with a parallel token. They are
    not any more, and that is the point of the second pass: inside a dive
    `--brass` IS the tradition's metal, re-cut in tokens.css, so every link,
    focus ring, active chip and rule on the page is already traditional without
    a single selector asking for it. The top bar and the rooms rail are
    themed by the same stroke, which is what "the sticky chrome lives in the
    theme's vocabulary" asks for.
  */
</style>
