---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Room not found.
 *
 * A museum plate, in the museum's own voice, and nothing more. No search box —
 * the top bar already carries one — no list of "popular pages", no joke. A
 * reader who mistyped a URL wants the door back to the entrance hall, and a 404
 * that performs is a 404 that wastes their time.
 *
 * Astro emits this as `dist/404.html`, which Vercel serves for any unmatched
 * path without configuration.
 */
---

<BaseLayout
  title="Room not found"
  description="This address does not resolve to a room in Axis Mundi."
  noindex
>
  <section class="shell notfound">
    <p class="eyebrow">Room not found</p>
    <h1>This door opens onto nothing.</h1>
    <p class="lede">
      The address you followed does not resolve to a room in this museum. It may have been
      renamed, or it may never have existed.
    </p>

    <div class="ornament" aria-hidden="true"><i></i><b></b><i></i></div>

    <p class="notfound__back">
      <a class="tap" href="/">Return to the entrance hall &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-12) var(--space-8);
    max-width: var(--measure);
  }

  .notfound h1 {
    margin-block: var(--space-3) var(--space-4);
  }

  .notfound .lede {
    color: var(--ink-soft);
  }

  .ornament {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 32.5rem;
    margin: var(--space-6) 0;
  }

  .ornament i {
    flex: 1;
    height: 3px;
    border-top: var(--hairline-width) solid var(--hairline);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .ornament b {
    width: 5px;
    height: 5px;
    rotate: 45deg;
    background: var(--brass);
    flex: 0 0 auto;
  }

  .notfound__back a {
    font-family: var(--font-ui);
  }
</style>
