---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishable } from '../../lib/content';
import { TRADITIONS } from '../../lib/traditions';
import { hasEnglish, originalLang, type WorkData } from '../../lib/reader-model';
import { fontFor } from '../../lib/scripts';

/**
 * The Reading Room — Phase 5.
 *
 * Scripture at reading quality, in editions whose rights are clean. The memo
 * states the licensing reality once and the whole room follows from it:
 * original-language scripture is public domain, modern English translation
 * mostly is not, so these are public-domain and CC0 editions, named on every
 * page, accepting archaic register as the price.
 *
 * A library is not only what is on its shelves. The canons still being
 * acquired have rows here too, and the two with no clean English edition say
 * so in the English slot rather than leaving it blank — named absence, never
 * filler, which is the same rule the rest of the museum reads by.
 */

const [entries, coming] = await Promise.all([
  getPublishable('works'),
  getPublishable('shelf'),
]);

const nameOf = new Map<string, string>(TRADITIONS.map((t) => [t.id, t.name]));

const shelf = entries
  .map((e) => e.data as unknown as WorkData)
  .sort((a, b) => a.title.localeCompare(b.title))
  .map((w) => ({
    work: w,
    tradition: nameOf.get(w.tradition) ?? w.tradition,
  }));

const waiting = coming
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order)
  .map((r) => ({ ...r, traditionName: nameOf.get(r.tradition) ?? r.tradition }));

const verses = shelf.reduce((n, s) => n + s.work.total_verses, 0);
---

<BaseLayout
  title="Reading Room"
  description="Scripture at reading quality, in public-domain and CC0 editions named on every page, with the original beside the English."
>
  <section class="shell head">
    <p class="eyebrow">Room IX · The Reading Room</p>
    <h1 class="display">The texts<br />themselves.</h1>
    <p class="room-says">The texts themselves, the original beside the English.</p>
    <p class="measure lede">
      Every other room in this museum describes what traditions hold. This one hands you the text
      and gets out of the way.
    </p>
    <div class="ornament" aria-hidden="true"><i></i><b></b><i></i></div>
  </section>

  <div class="shell rd-shelf">
    <h2 class="rd-shelf__heading">
      On the shelves
      {
        shelf.length > 0 && (
          <span class="caption rd-shelf__tally">
            {shelf.length} {shelf.length === 1 ? 'canon' : 'canons'} ·{' '}
            {verses.toLocaleString('en')} verses
          </span>
        )
      }
    </h2>

    {
      shelf.length === 0 ? (
        <p class="measure empty">
          No corpus has entered the build yet. Each arrives as a paired original-and-translation
          file and becomes sourced content like every other record.
        </p>
      ) : (
        <ul class="rd-shelf__list" role="list">
          {shelf.map((s) => (
            <li>
              <a class="rd-shelf__item" href={`/read/${s.work.id}`}>
                <span class="rd-shelf__title">
                  {s.work.title}
                  {s.work.title_original !== undefined && (
                    <span
                      class="rd-shelf__original"
                      lang={originalLang(s.work)}
                      dir={s.work.direction}
                      style={`font-family: ${fontFor(s.work.script)}`}
                    >
                      {s.work.title_original}
                    </span>
                  )}
                </span>
                <span class="caption rd-shelf__meta">
                  {s.tradition} · {s.work.divisions.length} {s.work.division_label_plural} ·{' '}
                  {s.work.total_verses.toLocaleString('en')} verses
                  {!hasEnglish(s.work) && ' · original only'}
                </span>
              </a>
              {/* Filled in by the island only where there is a position to
                  resume from; an offer that goes nowhere is worse than none. */}
              <p class="rd-resume caption" data-resume={s.work.id} hidden>
                <a class="rd-resume__link" href={`/read/${s.work.id}`}></a>
              </p>
            </li>
          ))}
        </ul>
      )
    }

    {
      waiting.length > 0 && (
        <>
          <h2 class="rd-shelf__heading rd-shelf__heading--waiting">Being acquired</h2>
          <p class="measure caption rd-shelf__intro">
            The canons the owner is bringing in, and the editions they will arrive in. Two of them
            have no public-domain English of any quality, and those rows say so — a library is
            honest about its gaps or it is a showroom.
          </p>

          <ul class="rd-waiting" role="list">
            {waiting.map((r) => (
              /* The id is the anchor a deep dive's canon table links to, so a
                 reader following "the Bible" from Christianity lands on this
                 row rather than on the top of a page they must then search. */
              <li class="rd-waiting__row" id={r.id}>
                <h3 class="rd-waiting__title">
                  {r.title}
                  <span class="caption rd-waiting__tradition">{r.traditionName}</span>
                </h3>
                <dl class="rd-waiting__editions">
                  <div>
                    <dt class="caption">Original</dt>
                    <dd>{r.original}</dd>
                  </div>
                  <div>
                    <dt class="caption">English</dt>
                    {r.english === undefined ? (
                      <dd class="rd-waiting__absent">{r.english_unresolved}</dd>
                    ) : (
                      <dd>{r.english}</dd>
                    )}
                  </div>
                </dl>
                <p class="rd-waiting__status">{r.status}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="measure caption rd-shelf__note">
      Editions are public domain or CC0 and named on every page. Where no such English edition
      exists, the original enters alone and the English slot says what it is waiting on rather
      than standing empty.
    </p>
  </div>

  <script>
    import '../../scripts/reader';
  </script>
</BaseLayout>

<style>
  .rd-shelf {
    padding-bottom: var(--space-16);
  }

  .rd-shelf__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--size-h3);
    max-width: 42rem;
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: var(--hairline-width) solid var(--ink);
  }

  .rd-shelf__heading--waiting {
    margin-top: var(--space-16);
  }

  .rd-shelf__tally {
    color: var(--ink-soft);
    font-family: var(--font-ui);
    flex: none;
  }

  .rd-shelf__intro {
    color: var(--ink-soft);
    margin-bottom: var(--space-6);
  }

  .rd-shelf__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-1);
    max-width: 42rem;
  }

  .rd-shelf__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: var(--tap-min);
    padding: var(--space-4) 0;
    border-bottom: var(--hairline-width) solid var(--hairline);
    color: var(--ink);
    text-decoration: none;
  }

  .rd-shelf__title {
    font-family: var(--font-display);
    font-size: var(--size-h3);
  }

  .rd-shelf__original {
    margin-left: var(--space-3);
    color: var(--ink-soft);
  }

  .rd-shelf__meta {
    color: var(--ink-soft);
  }

  .rd-shelf__item:hover .rd-shelf__title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* --- resume ------------------------------------------------------------ */

  .rd-resume {
    padding-bottom: var(--space-3);
  }

  .rd-resume__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--brass-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- being acquired ---------------------------------------------------- */

  /*
    A waiting row is a card, not a list item: it carries two editions and a
    paragraph, and set as a flat row it read as though the canon were already
    readable. The surface says "not yet" before any of the words do.
  */
  .rd-waiting {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
  }

  .rd-waiting__row {
    padding: var(--space-4);
    background: var(--surface);
    border-left: var(--hairline-width) solid var(--hairline);
    scroll-margin-top: 9rem;
  }

  /* A reader arriving from a dive's canon table needs to see which row it
     was, and the brass says so for exactly as long as the fragment holds. */
  .rd-waiting__row:target {
    border-left-color: var(--brass);
    border-left-width: 3px;
    padding-left: calc(var(--space-4) - 2px);
  }

  .rd-waiting__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--size-body);
    margin-bottom: var(--space-3);
  }

  .rd-waiting__tradition {
    color: var(--ink-soft);
    font-family: var(--font-ui);
    flex: none;
  }

  .rd-waiting__editions {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .rd-waiting__editions dt {
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-ui);
  }

  .rd-waiting__editions dd {
    margin: 0;
    font-size: var(--size-small);
  }

  /*
    The named absence. Set in the same slot and the same size as an edition
    that exists, because it is the same kind of statement — the museum saying
    what is there — and shrinking it would read as an apology.
  */
  .rd-waiting__absent {
    color: var(--ink-soft);
    font-style: italic;
  }

  .rd-waiting__status {
    font-size: var(--size-small);
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .rd-shelf__note {
    margin-top: var(--space-12);
    color: var(--ink-soft);
  }
</style>
