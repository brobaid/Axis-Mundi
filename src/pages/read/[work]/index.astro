---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishable } from '../../../lib/content';
import {
  divisionHeading,
  grouped,
  langTag,
  parallelCounts,
  verseRange,
  hasEnglish,
  originalLang,
  type WorkData,
} from '../../../lib/reader-model';
import { fontFor } from '../../../lib/scripts';

/** A canon's contents: every division, in its own order, under its own sections. */
export const getStaticPaths = (async () => {
  const works = await getPublishable('works');
  return works.map((entry) => ({
    params: { work: entry.data.id },
    props: { work: entry.data as unknown as WorkData },
  }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;
const blocks = grouped(work);
const sources = await getPublishable('sources');
const titleOf = new Map(sources.map((s) => [s.data.id, s.data.title]));
const orig = originalLang(work);
const scriptFont = fontFor(work.script);

const verses = work.total_verses.toLocaleString('en');
/* A canon with no verse level has only one number to give: the Daodejing is
   eighty-one chapters, and "81 chapters, 81 verses" claimed a division it does
   not make. */
const count =
  work.versified === false
    ? `${work.divisions.length} ${work.division_label_plural}`
    : `${work.divisions.length} ${work.division_label_plural}, ${verses} verses`;

/** "15, 18, 61 and 174" — the canon's own numbers, in a readable list. */
const listNumbers = (ns: readonly number[]): string =>
  ns.length <= 1
    ? ns.join('')
    : `${ns.slice(0, -1).join(', ')} and ${ns[ns.length - 1]}`;

const scale =
  count +
  (work.total_chapters === undefined
    ? ''
    : ` in ${work.total_chapters.toLocaleString('en')} chapters`) +
  '.';

/* The single-sided verses, named where they live. Two versifications that
   disagree leave a verse on one side only; that is a fact about the editions,
   so the page states it and says which books to expect it in rather than
   letting a reader meet it cold. */
/* A verse missing from both editions is counted in both totals and is one
   verse, not two. */
const oneSided = work.english_gaps + work.original_gaps - work.blank;
const oneSidedIn = work.divisions
  .filter((d) => d.english_gaps + d.original_gaps > 0)
  .map((d) => divisionHeading(work, d));
const listed =
  oneSidedIn.length <= 1
    ? oneSidedIn.join('')
    : `${oneSidedIn.slice(0, -1).join(', ')} and ${oneSidedIn[oneSidedIn.length - 1]}`;
---

<BaseLayout
  title={work.title}
  description={`${work.title}: ${count}, in editions named on every page.`}
>
  <section class="shell head">
    <p class="eyebrow">
      <a class="tap" href="/read">Reading Room</a>
    </p>
    <h1 class="display">{work.title}</h1>
    {
      work.title_original !== undefined && (
        <p class="rd-work__original" lang={langTag(work, orig)} dir={work.direction} style={`font-family: ${scriptFont}`}>
          {work.title_original}
        </p>
      )
    }
    <p class="measure lede">
      {/* One string, because JSX puts a space between adjacent expressions and
          a canon with no chapter level was getting "512 verses ." for it. */}
      {scale}
      {!hasEnglish(work) && ' This corpus has entered in its own language alone.'}
    </p>
    {/* Filled in by the island when there is somewhere to resume, and empty
        otherwise: an offer that goes nowhere is worse than no offer. */}
    <p class="rd-resume" data-resume={work.id} hidden>
      <a class="rd-resume__link" href={`/read/${work.id}`}></a>
    </p>
    <div class="ornament" aria-hidden="true"><i></i><b></b><i></i></div>
  </section>

  <div class="shell rd-contents">
    <p class="caption rd-contents__editions">
      {
        Object.entries(work.editions)
          .map(([, id]) => titleOf.get(id) ?? id)
          .join(' · ')
      }
      {/* Whatever this canon must state about itself, stated where a reader
          meets it first rather than only once they are inside a book. */}
      {work.note !== undefined && <span class="rd-contents__work-note">{work.note}</span>}
      {
        /* The pairing is the claim, so where it is incomplete the page says so
           here rather than leaving a reader to find the holes one book at a
           time. Both the count and the books are measured at ingestion. */
        /* Why differs by canon — two versifications disagreeing in one, a
           critical edition declining a verse in another — so the summary
           states the fact and the count, and each verse says its own why
           where it falls. */
        oneSided > 0 && (
          <span class="rd-contents__gaps">
            {oneSided} {oneSided === 1 ? 'verse stands' : 'verses stand'} on one side only, in{' '}
            {listed}. Each says so where it falls.
          </span>
        )
      }
      {/* Divisions the canon numbers and this corpus does not carry, by number.
          A contents page that simply stepped from 14 to 16 would read as a
          quirk of the numbering; naming them says what it is, which is a hole
          in the digitisation rather than in the work. */}
      {
        work.absent !== undefined && (
          <span class="rd-contents__absent">
            {work.absent.divisions.length} {work.division_label_plural} are not here —{' '}
            {work.division_label} {listNumbers(work.absent.divisions)}. {work.absent.note}
          </span>
        )
      }
    </p>

    {
      blocks.map(({ section, divisions }) => (
        <section class="rd-contents__block">
          {section !== undefined && (
            <h2 class="rd-contents__section" id={section.id}>
              <span>
                {section.name}
                {/* The canon's own name for the section, beside the one this
                    page can pronounce. Both, because the transliteration is
                    how it is spoken here and the Hebrew is what it is. */}
                {section.name_original !== undefined && (
                  <span
                    class="rd-contents__section-original"
                    lang={langTag(work, orig)}
                    dir={work.direction}
                    style={`font-family: ${scriptFont}`}
                  >
                    {section.name_original}
                  </span>
                )}
              </span>
              <span class="caption rd-contents__section-count">
                {divisions.length} {work.division_label_plural}
              </span>
            </h2>
          )}
          <ol class="rd-contents__list" role="list">
            {divisions.map((d) => (
              <li>
                <a class="rd-contents__item" href={`/read/${work.id}/${d.slug}`}>
                  {/* The numeral — but a division with no name of its own is
                      headed by its number already, and "1 Chapter 1" is the
                      same number twice. The cell stays, so the names below it
                      keep their column. */}
                  <span class="rd-contents__n mono">{d.name === undefined ? '' : d.n}</span>
                  <span class="rd-contents__name">
                    {divisionHeading(work, d)}
                    {d.name_original !== undefined && (
                      <span
                        class="rd-contents__original"
                        lang={langTag(work, orig)}
                        dir={work.direction}
                        style={`font-family: ${scriptFont}`}
                      >
                        {d.name_original}
                      </span>
                    )}
                    {/* What the division's own name means, where the delivery
                        gave us a rendering of it. */}
                    {d.name_gloss !== undefined && (
                      <span class="rd-contents__gloss">{d.name_gloss}</span>
                    )}
                  </span>
                  <span class="caption rd-contents__count">
                    {/* Where a canon numbers continuously, the range is the
                        thing a reader is scanning for: Dhp 183 is in whichever
                        vagga holds it, and nothing else on this page says so.

                        A division whose editions do not align has no single
                        number and says both, in the words each column counts
                        in — a bare "27" beside Analects X would quietly stand
                        for a pairing the book does not have. */}
                    {verseRange(d) ??
                      (d.parallel !== undefined
                        ? parallelCounts(d.parallel)
                        : d.chapters !== undefined
                          ? `${d.chapters.length} ch · ${d.verses}`
                          : /* An unversified canon's division holds one block,
                               and a column of "1" down eighty-one rows counts
                               nothing a reader could want. */
                            work.versified === false
                            ? ''
                            : `${d.verses}`)}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <script>
    import '../../../scripts/reader';
  </script>
</BaseLayout>

<style>
  .rd-work__original {
    font-size: var(--size-h2);
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .rd-contents {
    padding-bottom: var(--space-16);
  }

  .rd-resume {
    margin-bottom: var(--space-4);
  }

  .rd-resume__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--brass-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rd-contents__editions {
    color: var(--ink-soft);
    margin-bottom: var(--space-6);
    max-width: 42rem;
  }

  .rd-contents__work-note,
  .rd-contents__absent,
  .rd-contents__gaps {
    display: block;
    margin-top: var(--space-2);
  }

  .rd-contents__block + .rd-contents__block {
    margin-top: var(--space-12);
  }

  /*
    Torah, Nevi'im, Ketuvim are the canon's own divisions, not a presentation
    choice, so they get a heading in the display face over a full-ink rule —
    heavier than the soft hairline between books, and no brass: brass is the
    meridian's, and a contents page has no meridian on it.
  */
  .rd-contents__section {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--size-h3);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: var(--hairline-width) solid var(--ink);
    max-width: 42rem;
  }

  .rd-contents__section-count {
    color: var(--ink-soft);
    font-family: var(--font-ui);
    flex: none;
  }

  .rd-contents__section-original {
    margin-left: var(--space-3);
    color: var(--ink-soft);
  }

  .rd-contents__list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 42rem;
    /* Two columns where there is room: a hundred and fourteen entries is a
       long scroll on a laptop and a fine one on a phone. */
    columns: 1;
  }

  @media (min-width: 40rem) {
    .rd-contents__list {
      columns: 2;
      column-gap: var(--space-12);
    }
  }

  .rd-contents__list li {
    break-inside: avoid;
  }

  .rd-contents__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--tap-min);
    padding: var(--space-2) 0;
    border-bottom: var(--hairline-width) solid var(--hairline);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--size-small);
  }

  .rd-contents__n {
    flex: none;
    width: 2.5em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    text-align: right;
  }

  .rd-contents__name {
    flex: 1;
  }

  .rd-contents__original {
    margin-left: var(--space-2);
    color: var(--ink-soft);
  }

  .rd-contents__gloss {
    color: var(--ink-soft);
  }

  .rd-contents__gloss::before {
    content: ' / ';
  }

  .rd-contents__count {
    flex: none;
    color: var(--ink-soft);
  }

  .rd-contents__item:hover .rd-contents__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
