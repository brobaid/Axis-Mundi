---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReaderChrome from '../../../components/ReaderChrome.astro';
import { getPublishable } from '../../../lib/content';
import {
  availableModes,
  defaultMode,
  divisionHeading,
  divisionsOf,
  editionLines,
  hasEnglish,
  neighbours,
  originalLang,
  verseAnchor,
  type WorkData,
} from '../../../lib/reader-model';

/**
 * One division of one canon — Phase 5.
 *
 * Chunked a division per page because a canon is not a scroll: six thousand
 * verses on one page is a document nobody can hold a place in, and the anchors
 * a reader shares (`/read/quran/2#255`) need a page small enough to land on.
 *
 * Nothing here knows what a surah is. The label, the script, the direction and
 * the editions all come off the record, and a canon that arrives with no
 * English column renders in its own language with the English slot saying what
 * it waits on.
 */
export const getStaticPaths = (async () => {
  const works = await getPublishable('works');
  return works.flatMap((entry) => {
    const work = entry.data as unknown as WorkData;
    return divisionsOf(work).map((division) => ({
      params: { work: work.id, division: String(division.n) },
      props: { work, division },
    }));
  });
}) satisfies GetStaticPaths;

const { work, division } = Astro.props;

const all = divisionsOf(work);
const numbers = all.map((d) => d.n);
const { prev, next } = neighbours(numbers, division.n);
const modes = availableModes(work);
const mode = defaultMode(work);
const orig = originalLang(work);
const english = hasEnglish(work);

const sources = await getPublishable('sources');
const sourceById = new Map(sources.map((s) => [s.data.id, s.data]));
const notes = Object.fromEntries(
  sources.flatMap((s) => (s.data.note === undefined ? [] : [[s.data.id, s.data.note]])),
);
const editions = editionLines(work, notes).map((e) => {
  const record = sourceById.get(e.sourceId);
  return {
    ...e,
    title: record?.title ?? e.sourceId,
    ...(record?.author === undefined ? {} : { author: record.author }),
  };
});

const heading = divisionHeading(work, division);
/* "Surah 3" at the head of a link, not "surah 3". */
const Label = work.division_label.charAt(0).toUpperCase() + work.division_label.slice(1);

/* Written out rather than built by concatenation: a token name assembled from
   a variable is a token the audit cannot see, and every one of these has to be
   a property that exists. */
const SCRIPT_FONT: Record<string, string> = {
  arabic: 'var(--font-arabic)',
  hebrew: 'var(--font-hebrew)',
  devanagari: 'var(--font-devanagari)',
  gurmukhi: 'var(--font-gurmukhi)',
  han: 'var(--font-sc)',
  japanese: 'var(--font-jp)',
  latin: 'var(--font-prose)',
};
const scriptFont = SCRIPT_FONT[work.script] ?? 'var(--font-prose)';
---

<BaseLayout
  title={`${heading} — ${work.title}`}
  description={`${heading} of ${work.title}, ${division.verses.length} verses, in editions named on the page.`}
>
  <article class="shell rd">
    <header class="rd__head">
      <p class="eyebrow">
        <a class="tap" href="/read">Reading Room</a> ·{' '}
        <a class="tap" href={`/read/${work.id}`}>{work.title}</a>
      </p>
      <h1 class="rd__title">
        {heading}
        {
          division.name_original !== undefined && (
            <span class="rd__title-original" lang={orig} dir={work.direction}
                  style={`font-family: ${scriptFont}`}>
              {division.name_original}
            </span>
          )
        }
      </h1>
      <p class="caption rd__count">
        {division.verses.length} verses
        {division.transliteration !== undefined && ` · ${division.transliteration}`}
      </p>
    </header>

    <ReaderChrome
      modes={modes}
      mode={mode}
      editions={editions}
      englishPending={work.english_pending}
      note={work.note}
    />

    {/* The mode is a class on this container, resolved in CSS against the modes
        this work can actually offer, so a stored preference a corpus cannot
        honour falls back to the work's own default rather than an empty page. */}
    <div
      class="rd-verses"
      data-modes={modes.join(' ')}
      data-default={mode}
      style={`--script-font: ${scriptFont}`}
    >
      {
        division.verses.map((verse) => (
          <div class="rd-verse" id={verseAnchor(verse)}>
            <a class="rd-verse__n mono" href={`#${verseAnchor(verse)}`}
               aria-label={`Verse ${division.n}:${verse.a}`}>
              {verse.a}
            </a>
            <div class="rd-verse__body">
              {english && (
                <p class="rd-verse__en" lang="en">
                  {verse['en']}
                </p>
              )}
              {/* Always dir and lang in the markup, never by CSS: the direction
                  a paragraph is set in decides where its punctuation lands, and
                  that must not depend on which column is showing. */}
              <p class="rd-verse__orig" lang={orig} dir={work.direction}>
                {verse[orig]}
              </p>
              {!english && <p class="rd-verse__pending caption">{work.english_pending}</p>}
            </div>
          </div>
        ))
      }
    </div>

    <nav class="rd-nav" aria-label={`${work.division_label_plural}`}>
      {
        prev === undefined ? (
          <span />
        ) : (
          <a class="rd-nav__link" href={`/read/${work.id}/${prev}`} rel="prev">
            <span aria-hidden="true">←</span> {Label} {prev}
          </a>
        )
      }

      <label class="rd-jump">
        <span class="visually-hidden">Jump to a {work.division_label}</span>
        <select class="rd-jump__select" data-reader-jump data-work={work.id}>
          {
            all.map((d) => (
              <option value={d.n} selected={d.n === division.n}>
                {d.name === undefined
                  ? `${work.division_label.charAt(0).toUpperCase()}${work.division_label.slice(1)} ${d.n}`
                  : `${d.n} · ${d.name}`}
              </option>
            ))
          }
        </select>
      </label>

      {
        next === undefined ? (
          <span />
        ) : (
          <a class="rd-nav__link rd-nav__link--next" href={`/read/${work.id}/${next}`} rel="next">
            {Label} {next} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>

    <p class="caption rd__contents-link">
      <a class="tap" href={`/read/${work.id}`}>All {all.length} {work.division_label_plural}</a>
    </p>
  </article>

  <script>
    import '../../../scripts/reader';
  </script>
</BaseLayout>

<style is:global>
  .rd {
    padding-block: var(--space-12) var(--space-16);
    max-width: 46rem;
  }

  .rd__head {
    margin-bottom: var(--space-6);
  }

  .rd__title {
    font-family: var(--font-display);
    font-size: var(--size-h1);
    line-height: 1.15;
  }

  .rd__title-original {
    margin-left: var(--space-4);
    color: var(--ink-soft);
  }

  .rd__count {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  /* --- the text ---------------------------------------------------------- */

  .rd-verse {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--hairline-width) solid var(--hairline);
    /* An anchored verse must clear the sticky header; the global
       scroll-padding-top handles the page, this handles the element. */
    scroll-margin-top: 9rem;
  }

  .rd-verse:target {
    background: var(--surface);
    /* The brass rule marks where a shared link landed, and nothing else. */
    box-shadow: inset 3px 0 0 var(--brass);
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
  }

  /* The numeral is small by design and its target is not: the link stretches
     to the verse's own height, which on a one-line verse is the difference
     between a 29px target and a reachable one. */
  .rd-verse__n {
    flex: none;
    width: 3ch;
    align-self: stretch;
    min-height: var(--tap-min);
    text-align: right;
    font-size: var(--size-caption);
    color: var(--ink-soft);
    text-decoration: none;
    padding-top: 0.35em;
  }

  .rd-verse__n:hover {
    color: var(--brass-ink);
  }

  .rd-verse__body {
    flex: 1;
    min-width: 0;
  }

  /* Reading measure and leading, tuned for the Latin column. */
  .rd-verse__en {
    font-family: var(--font-prose);
    font-size: 1.0625rem;
    line-height: 1.72;
    max-width: 36rem;
  }

  /*
    The original is tuned independently, because it has to be. Naskh sets
    small against Latin at the same nominal size and carries diacritics above
    and below the line, so it wants both more size and more leading — matching
    the Latin numbers would give a cramped, unreadable block.
  */
  .rd-verse__orig {
    font-family: var(--script-font);
    font-size: 1.5rem;
    line-height: 2.15;
    max-width: 36rem;
    margin-top: var(--space-3);
  }

  .rd-verse__pending {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  /* --- the three modes, resolved against what this work offers ----------- */

  .rd-verses[data-default='english'] .rd-verse__orig,
  .rd-verses[data-default='original'] .rd-verse__en {
    display: none;
  }

  :root[data-reading-mode='english'] .rd-verses[data-modes~='english'] .rd-verse__en,
  :root[data-reading-mode='both'] .rd-verses[data-modes~='both'] .rd-verse__en,
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__orig,
  :root[data-reading-mode='both'] .rd-verses[data-modes~='both'] .rd-verse__orig {
    display: block;
  }

  :root[data-reading-mode='english'] .rd-verses[data-modes~='english'] .rd-verse__orig,
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__en {
    display: none;
  }

  /* Original alone: the numeral belongs at the reading edge, which for an RTL
     script is the right. The text's own direction is in the markup and never
     moves; this is alignment, not bidi. */
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse,
  .rd-verses[data-default='original'] .rd-verse {
    flex-direction: row-reverse;
  }

  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__n,
  .rd-verses[data-default='original'] .rd-verse__n {
    text-align: left;
  }

  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__orig,
  .rd-verses[data-default='original'] .rd-verse__orig {
    margin-top: 0;
    margin-left: auto;
  }

  /* --- navigation -------------------------------------------------------- */

  .rd-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--hairline-width) solid var(--hairline);
  }

  .rd-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    text-decoration: none;
  }

  .rd-nav__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rd-jump__select {
    max-width: 12rem;
    min-height: var(--tap-min);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    color: var(--ink);
    background: var(--surface);
    border: var(--hairline-width) solid var(--hairline);
    padding: 0 var(--space-2);
  }

  .rd__contents-link {
    margin-top: var(--space-4);
  }

  /* --- print ------------------------------------------------------------- */

  /*
    Scripture is the likeliest thing here to be printed, so the page is set for
    paper rather than merely surviving it: the site chrome goes, the measure
    widens to the sheet, and a verse never breaks across a page.
  */
  @media print {
    .rd {
      max-width: none;
      padding: 0;
    }

    .rd-verse {
      break-inside: avoid;
      border-bottom: none;
      padding-block: var(--space-2);
    }

    .rd-verse:target {
      background: none;
      box-shadow: none;
      padding-left: 0;
      margin-left: 0;
    }

    .rd-verse__en,
    .rd-verse__orig {
      max-width: none;
    }

    .rd-nav,
    .rd__contents-link {
      display: none;
    }

    /* The edition line is the one piece of chrome that must survive: a printed
       page of scripture with no edition named is an unsourced page. */
    .rd-edition {
      border-bottom: var(--hairline-width) solid var(--ink);
    }
  }
</style>
