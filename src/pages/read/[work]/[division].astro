---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReaderChrome from '../../../components/ReaderChrome.astro';
import { getPublishable } from '../../../lib/content';
import {
  availableModes,
  byChapter,
  defaultMode,
  divisionHeading,
  editionLines,
  hasEnglish,
  neighbours,
  originalLang,
  sectionOf,
  verseAnchor,
  verseRef,
  type DivisionIndex,
  type VerseRow,
  type WorkData,
} from '../../../lib/reader-model';
import { fontFor } from '../../../lib/scripts';

/**
 * One division of one canon — Phase 5.
 *
 * Chunked a division per page because a canon is not a scroll: twenty-three
 * thousand verses on one page is a document nobody can hold a place in, and
 * the anchors a reader shares need a page small enough to land on.
 *
 * This route loads its own division record and nothing else. The delivered
 * corpus file is the owner's format; it is never the build's working set here
 * and never reaches a browser.
 */
export const getStaticPaths = (async () => {
  const works = await getPublishable('works');
  return works.flatMap((entry) => {
    const work = entry.data as unknown as WorkData;
    return work.divisions.map((division) => ({
      params: { work: work.id, division: division.slug },
      props: { work, division },
    }));
  });
}) satisfies GetStaticPaths;

interface Props {
  work: WorkData;
  division: DivisionIndex;
}
const { work, division } = Astro.props as Props;

const record = await getEntry('divisions', `${work.id}--${division.slug}`);
const verses = (record?.data.verses ?? []) as unknown as VerseRow[];
if (verses.length === 0) {
  /* A division page with no text is not a page. The only way here is a work
     index naming a division whose record is missing, which is a build-time
     fact and must stop the build rather than ship an empty room. */
  throw new Error(`no division record for ${work.id}--${division.slug}`);
}
const chapters = byChapter(verses);

const { prev, next } = neighbours(work, division.n);
const section = sectionOf(work, division.n);
const modes = availableModes(work);
const mode = defaultMode(work);
const orig = originalLang(work);
const english = hasEnglish(work);

const sources = await getPublishable('sources');
const sourceById = new Map(sources.map((s) => [s.data.id, s.data]));
const notes = Object.fromEntries(
  sources.flatMap((s) => (s.data.note === undefined ? [] : [[s.data.id, s.data.note]])),
);
const editions = editionLines(work, notes).map((e) => {
  const record = sourceById.get(e.sourceId);
  return {
    ...e,
    title: record?.title ?? e.sourceId,
    ...(record?.author === undefined ? {} : { author: record.author }),
  };
});

const heading = divisionHeading(work, division);
const scriptFont = fontFor(work.script);
const label = (d: DivisionIndex): string => divisionHeading(work, d);
---

<BaseLayout
  title={`${heading} — ${work.title}`}
  description={`${heading} of ${work.title}, ${division.verses} verses, in editions named on the page.`}
>
  <article class="shell rd" data-reader data-work={work.id} data-division={division.slug}>
    <header class="rd__head">
      <p class="eyebrow">
        <a class="tap" href="/read">Reading Room</a> ·{' '}
        <a class="tap" href={`/read/${work.id}`}>{work.title}</a>
        {section !== undefined && <span class="rd__section"> · {section.name}</span>}
      </p>
      <h1 class="rd__title">
        {heading}
        {
          division.name_original !== undefined && (
            <span class="rd__title-original" lang={orig} dir={work.direction}
                  style={`font-family: ${scriptFont}`}>
              {division.name_original}
            </span>
          )
        }
      </h1>
      <p class="caption rd__count">
        {division.verses} verses
        {division.chapters !== undefined && ` in ${division.chapters} chapters`}
        {division.transliteration !== undefined && ` · ${division.transliteration}`}
      </p>
    </header>

    <ReaderChrome
      modes={modes}
      mode={mode}
      editions={editions}
      englishPending={work.english_pending}
      note={work.note}
    />

    {/* The mode is an attribute on this container, resolved in CSS against the
        modes this work can actually offer, so a stored preference a corpus
        cannot honour falls back to the work's own default. */}
    <div
      class="rd-verses"
      data-modes={modes.join(' ')}
      data-default={mode}
      data-script={work.script}
      data-direction={work.direction}
      style={`--script-font: ${scriptFont}`}
    >
      {
        chapters.map((chapter) => (
          /* One element per chapter: the chapter is the unit this canon is
             cited and read in, and grouping makes it one in the document too.

             Measured and rejected: content-visibility on this element. It
             saved nothing on a 4× throttled phone (FCP 204ms against 200ms)
             and it broke the thing the copy-link exists for — a fragment deep
             in Psalms landed twelve thousand pixels from the verse, because a
             reserved height is a guess and the guess was 7% out over a book. */
          <section class="rd-chapter-group">
            {chapter.c !== undefined && (
              <h2 class="rd-chapter" id={`c${chapter.c}`}>
                <span class="rd-chapter__label">Chapter</span> {chapter.c}
              </h2>
            )}
            {chapter.verses.map((verse) => (
              <div class="rd-verse" id={verseAnchor(verse)}>
                <a
                  class="rd-verse__n"
                  href={`#${verseAnchor(verse)}`}
                  aria-label={`Verse ${verseRef(heading, verse)}`}
                >
                  {verse.v}
                </a>
                {english && verse['en'] !== undefined && <p class="rd-verse__en">{verse['en']}</p>}
                {/* An edition can be sparse where two traditions number a
                    passage differently. The fact is stated; the reason is the
                    owner's to write, not this page's to guess. */}
                {english && verse['en'] === undefined && (
                  <p class="rd-verse__gap caption">
                    No English at this verse number in this edition.
                  </p>
                )}
                {/* dir and lang live in the markup, never in CSS: the direction
                    a paragraph is set in decides where its punctuation lands,
                    and that must not depend on which column is showing. */}
                <p class="rd-verse__orig" lang={orig} dir={work.direction}>
                  {verse[orig]}
                </p>
                {!english && <p class="rd-verse__pending caption">{work.english_pending}</p>}
              </div>
            ))}
          </section>
        ))
      }
    </div>

    <nav class="rd-nav" aria-label={work.division_label_plural}>
      {
        prev === undefined ? (
          <span />
        ) : (
          <a class="rd-nav__link" href={`/read/${work.id}/${prev.slug}`} rel="prev">
            <span aria-hidden="true">←</span> {label(prev)}
          </a>
        )
      }

      <label class="rd-jump">
        <span class="visually-hidden">Jump to a {work.division_label}</span>
        <select class="rd-jump__select" data-reader-jump data-work={work.id}>
          {
            work.divisions.map((d) => (
              <option value={d.slug} selected={d.slug === division.slug}>
                {label(d)}
              </option>
            ))
          }
        </select>
      </label>

      {
        next === undefined ? (
          <span />
        ) : (
          <a class="rd-nav__link rd-nav__link--next" href={`/read/${work.id}/${next.slug}`} rel="next">
            {label(next)} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>

    {
      section !== undefined && next === undefined && (
        <p class="caption rd__section-end">
          {label(division)} ends {section.name}. The {work.division_label_plural} of the next
          section are on the <a class="tap" href={`/read/${work.id}`}>contents page</a>.
        </p>
      )
    }

    <p class="caption rd__contents-link">
      <a class="tap" href={`/read/${work.id}`}>
        All {work.divisions.length} {work.division_label_plural}
      </a>
    </p>

  </article>

  <script>
    import '../../../scripts/reader';
  </script>
</BaseLayout>

<style is:global>
  .rd {
    padding-block: var(--space-12) var(--space-16);
    max-width: 46rem;
  }

  .rd__head {
    margin-bottom: var(--space-6);
  }

  .rd__title {
    font-family: var(--font-display);
    font-size: var(--size-h1);
    line-height: 1.15;
  }

  .rd__title-original {
    margin-left: var(--space-4);
    color: var(--ink-soft);
  }

  .rd__count {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  /* --- chapters ---------------------------------------------------------- */

  /*
    A chapter heading is a waypoint inside a book, not a title: it sits at the
    weight of the running text and earns its prominence from the rule above it
    rather than from size. Genesis has fifty of these; fifty h2s at display
    scale would read as fifty separate documents.
  */
  .rd-chapter {
    font-family: var(--font-ui);
    font-size: var(--size-small);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--hairline-width) solid var(--hairline);
    scroll-margin-top: 9rem;
  }

  .rd-chapter-group:first-child .rd-chapter {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .rd-chapter__label {
    color: var(--ink-soft);
  }

  /* --- the text ---------------------------------------------------------- */

  /*
    A grid rather than a flex row around a wrapper div. The wrapper was one
    element per verse and this canon has twenty-three thousand of them, so it
    was worth removing: the numeral takes the first column and every part of
    the verse's body stacks in the second.
  */
  .rd-verse {
    display: grid;
    grid-template-columns: 3ch 1fr;
    column-gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--hairline-width) solid var(--hairline);
    /* An anchored verse must clear the sticky header; the global
       scroll-padding-top handles the page, this handles the element. */
    scroll-margin-top: 9rem;
  }

  .rd-verse > * {
    grid-column: 2;
  }

  .rd-verse:target {
    background: var(--surface);
    /* The brass rule marks where a shared link landed, and nothing else. */
    box-shadow: inset 3px 0 0 var(--brass);
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
  }

  /* The numeral is small by design and its target is not: the link stretches
     to the verse's own height, which on a one-line verse is the difference
     between a 29px target and a reachable one. */
  .rd-verse__n {
    grid-column: 1;
    grid-row: 1 / -1;
    min-height: var(--tap-min);
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    color: var(--ink-soft);
    text-decoration: none;
    padding-top: 0.35em;
  }

  .rd-verse__n:hover {
    color: var(--brass-ink);
  }

  /* Reading measure and leading, tuned for the Latin column. */
  .rd-verse__en {
    font-family: var(--font-prose);
    font-size: 1.0625rem;
    line-height: 1.72;
    max-width: 36rem;
  }

  /*
    The original is tuned independently, because it has to be. Naskh sets small
    against Latin at the same nominal size and carries diacritics above and
    below the line, so it wants both more size and more leading — matching the
    Latin numbers would give a cramped, unreadable block.
  */
  .rd-verse__orig {
    font-family: var(--script-font);
    font-size: 1.5rem;
    line-height: 2.15;
    max-width: 36rem;
    margin-top: var(--space-3);
  }

  /*
    Hebrew is pointed on both sides of the line here: cantillation above,
    vowel points below, sometimes three deep. The Masoretic text needs the
    leading more than it needs the size — Noto Serif Hebrew sets larger than
    Naskh at the same nominal size — so this takes size down and leading up.
  */
  .rd-verses[data-script='hebrew'] .rd-verse__orig {
    font-size: 1.375rem;
    line-height: 2.35;
  }

  .rd-verse__pending,
  .rd-verse__gap {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  /* --- the three modes, resolved against what this work offers ----------- */

  .rd-verses[data-default='english'] .rd-verse__orig,
  .rd-verses[data-default='original'] .rd-verse__en {
    display: none;
  }

  :root[data-reading-mode='english'] .rd-verses[data-modes~='english'] .rd-verse__en,
  :root[data-reading-mode='both'] .rd-verses[data-modes~='both'] .rd-verse__en,
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__orig,
  :root[data-reading-mode='both'] .rd-verses[data-modes~='both'] .rd-verse__orig {
    display: block;
  }

  :root[data-reading-mode='english'] .rd-verses[data-modes~='english'] .rd-verse__orig,
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__en {
    display: none;
  }

  /* The gap note stands in for an English column, so it hides with one. */
  .rd-verses[data-default='original'] .rd-verse__gap,
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__gap {
    display: none;
  }

  /* Original alone: the numeral belongs at the reading edge, which for an RTL
     script is the right. The text's own direction is in the markup and never
     moves; this is column order, not bidi. */
  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'][data-direction='rtl'] .rd-verse,
  .rd-verses[data-default='original'][data-direction='rtl'] .rd-verse {
    grid-template-columns: 1fr 3ch;
  }

  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'][data-direction='rtl'] .rd-verse > *,
  .rd-verses[data-default='original'][data-direction='rtl'] .rd-verse > * {
    grid-column: 1;
  }

  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'][data-direction='rtl'] .rd-verse__n,
  .rd-verses[data-default='original'][data-direction='rtl'] .rd-verse__n {
    grid-column: 2;
    text-align: left;
  }

  :root[data-reading-mode='original'] .rd-verses[data-modes~='original'] .rd-verse__orig,
  .rd-verses[data-default='original'] .rd-verse__orig {
    margin-top: 0;
    margin-left: auto;
  }

  /* --- navigation -------------------------------------------------------- */

  .rd-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--hairline-width) solid var(--hairline);
  }

  .rd-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    text-decoration: none;
  }

  .rd-nav__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Deuteronomy has no next; Joshua begins a section rather than continuing
     one. The empty half of the row keeps the jump control centred. */
  .rd-nav__link--next {
    text-align: right;
  }

  .rd-jump__select {
    max-width: 12rem;
    min-height: var(--tap-min);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    color: var(--ink);
    background: var(--surface);
    border: var(--hairline-width) solid var(--hairline);
    padding: 0 var(--space-2);
  }

  .rd__section-end,
  .rd__contents-link {
    margin-top: var(--space-4);
    color: var(--ink-soft);
  }

  /* --- print ------------------------------------------------------------- */

  /*
    Scripture is the likeliest thing here to be printed, so the page is set for
    paper rather than merely surviving it: the site chrome goes, the measure
    widens to the sheet, and a verse never breaks across a page.
  */
  @media print {
    .rd {
      max-width: none;
      padding: 0;
    }

    .rd-verse {
      break-inside: avoid;
      border-bottom: none;
      padding-block: var(--space-2);
    }

    .rd-chapter {
      break-after: avoid;
    }

    .rd-verse:target {
      background: none;
      box-shadow: none;
      padding-left: 0;
      margin-left: 0;
    }

    .rd-verse__en,
    .rd-verse__orig {
      max-width: none;
    }

    .rd-nav,
    .rd__contents-link,
    .rd__section-end {
      display: none;
    }

    /* The edition line is the one piece of chrome that must survive: a printed
       page of scripture with no edition named is an unsourced page. */
    .rd-edition {
      border-bottom: var(--hairline-width) solid var(--ink);
    }
  }
</style>
