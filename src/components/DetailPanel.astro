---
/**
 * The shared detail panel (design language §8).
 *
 * One component, used by every canvas: the timeline's event panel and the map's
 * realm card are the same object. Desktop side panel, mobile bottom sheet,
 * canvas dims 20% behind it (§7), Esc and tap-out close, and the canvas
 * position underneath is never disturbed.
 *
 * The shell lives here; each island fills [data-panel-body] with its own
 * content through src/lib/panel.ts.
 */
---

<div class="panel-scrim" data-panel-scrim hidden></div>
<aside
  class="panel"
  data-panel
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="panel-title"
>
  <button type="button" class="panel__close" data-panel-close aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
  <div data-panel-body></div>
</aside>

<style>
  .panel-scrim {
    position: fixed;
    inset: 0;
    background: var(--scrim);
    z-index: var(--z-panel);
    animation: panel-fade var(--dur-panel) var(--ease-standard);
  }

  .panel {
    position: fixed;
    z-index: var(--z-sheet);
    top: 0;
    bottom: 0;
    right: 0;
    width: min(430px, 100vw);
    background: var(--surface);
    border-left: var(--hairline-width) solid var(--hairline);
    box-shadow: var(--shadow-panel);
    overflow-y: auto;
    padding: var(--space-6) var(--space-6) var(--space-8);
    animation: panel-slide var(--dur-panel) var(--ease-standard);
  }

  .panel__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: var(--tap-min);
    height: var(--tap-min);
    font-size: 20px;
    color: var(--ink-soft);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .panel :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.15;
    margin: 0 0 6px;
  }

  .panel :global(.panel__meta) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    margin: 6px 0 12px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    text-transform: capitalize;
  }

  .panel :global(.panel__meta span) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* The rule-and-diamond ornament from the design export. */
  .panel :global(.panel__rule) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0 14px;
  }

  .panel :global(.panel__rule i) {
    flex: 1;
    height: 3px;
    border-top: var(--hairline-width) solid var(--hairline);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .panel :global(.panel__rule b) {
    width: 4px;
    height: 4px;
    rotate: 45deg;
    background: var(--brass);
    flex: 0 0 auto;
  }

  .panel :global(.panel__label) {
    background: var(--surface);
    border: var(--hairline-width) solid var(--ink);
    box-shadow:
      0 0 0 2px var(--surface),
      0 0 0 3px var(--hairline);
    padding: 12px 14px;
    margin-bottom: 14px;
  }

  .panel :global(.panel__row) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-top: var(--hairline-width) solid var(--hairline);
    font-size: 14px;
    text-transform: capitalize;
  }

  .panel :global(.panel__row:first-of-type) {
    border-top: 0;
  }

  .panel :global(.panel__row span:first-child) {
    font-family: var(--font-ui);
    color: var(--ink-soft);
    font-size: 12.5px;
    text-transform: none;
  }

  .panel :global(.panel__contested) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
    margin-bottom: var(--space-4);
    font-size: var(--size-small);
    color: var(--ink-soft);
  }

  /* A node's own sentence, then the museum's note about how it renders that
     node. The second is set back, because it is this site talking about
     itself rather than about a tradition. */
  .panel :global(.panel__summary) {
    margin-bottom: var(--space-2);
  }

  .panel :global(.panel__editorial) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-3);
    border-left: var(--hairline-width) solid var(--hairline);
    color: var(--ink-soft);
  }

  .panel :global(.panel__editorial-tag) {
    font-family: var(--font-mono);
  }

  .panel :global(.panel__body) {
    margin: 14px 0;
  }

  .panel :global(.panel__sources) {
    border-top: var(--hairline-width) solid var(--hairline);
    padding-top: 12px;
    margin-top: 14px;
  }

  @keyframes panel-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes panel-slide {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  /* Mobile: the panel becomes a bottom sheet. */
  @media (max-width: 48rem) {
    .panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 82vh;
      border-left: 0;
      border-top: var(--hairline-width) solid var(--hairline);
      box-shadow: var(--shadow-sheet);
      animation-name: panel-sheet;
    }
  }

  @keyframes panel-sheet {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-scrim,
    .panel {
      animation: none;
    }
  }
</style>
