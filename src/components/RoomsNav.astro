---
import { getPublishable } from '../lib/content';

/**
 * The rooms rail (reference build's tab bar).
 *
 * M4 brings the room count to five, which is one more than the top bar can
 * carry at 390px beside the wordmark, search and the mode toggle. The reference
 * build already solved this: a second row under the header, scrolling
 * horizontally, each room a chip. Living inside the sticky header means there
 * is no magic offset between two sticky elements to keep in sync.
 *
 * A room only appears when it has somewhere to go. The deep dives are gated
 * behind their own sourcing, so in production the chip is absent rather than a
 * link to a 404 — the same rule the home page's door follows, where the door
 * stays visible and says what it is waiting on.
 */

const dives = await getPublishable('deepDives');

const rooms: { href: string; label: string }[] = [
  { href: '/timeline', label: 'Timeline' },
  { href: '/map', label: 'Map' },
  /* The index lists every dive, so the chip opens as soon as one exists. */
  ...(dives.length === 0 ? [] : [{ href: '/traditions', label: 'Deep dives' }]),
  { href: '/matrix', label: 'Matrix' },
  { href: '/compare', label: 'Compare' },
  { href: '/tree', label: 'Family tree' },
];

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';

/* `/traditions/islam` should light the Deep dives chip, not nothing. */
const isCurrent = (href: string): 'page' | undefined =>
  path === href || (href.startsWith('/traditions/') && path.startsWith('/traditions/'))
    ? 'page'
    : undefined;
---

<nav class="rooms" aria-label="Rooms">
  <ul role="list">
    {
      rooms.map((room) => (
        <li>
          <a class="room" href={room.href} aria-current={isCurrent(room.href)}>
            {room.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rooms {
    border-top: var(--hairline-width) solid var(--hairline);
    overflow-x: auto;
    scrollbar-width: none;
    /* The rail scrolls; the page never does. */
    overscroll-behavior-x: contain;
  }

  .rooms::-webkit-scrollbar {
    display: none;
  }

  .rooms ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: var(--space-2) 0;
    margin: 0;
    width: max-content;
    min-width: 100%;
  }

  .room {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    min-height: var(--tap-min);
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .room:hover {
    color: var(--ink);
  }

  .room[aria-current='page'] {
    background: var(--surface);
    box-shadow: inset 0 0 0 var(--hairline-width) var(--hairline);
    color: var(--ink);
  }

  /* The brass dot marks the room you are standing in, so the current chip is
     not distinguished by its fill alone. */
  .room[aria-current='page']::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brass);
    margin-right: var(--space-2);
    flex: none;
  }
</style>
