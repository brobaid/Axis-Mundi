---
/**
 * A one-line invitation to turn the phone, shown once.
 *
 * Portrait phones only, and only in the two rooms with a wide canvas. It never
 * blocks: it sits above the room's own chrome, dismisses on a tap, and is
 * never shown again. Storage failing means it greets the reader once more,
 * which is the same graceful degradation the first-visit coach makes.
 */
interface Props {
  /** The room, so the two hints are remembered separately. */
  room: 'timeline' | 'map' | 'wheel';
  /** One line, in the house voice. */
  line: string;
}
const { room, line } = Astro.props;
---

<div class="rotate" data-landscape-hint={room} hidden>
  <p class="rotate__line">
    <!-- A phone turning, drawn rather than iconified: no glyph font, no emoji. -->
    <svg class="rotate__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="7.5" y="1.5" width="9" height="15" rx="1.5" />
      <path d="M4.6 13.5A8 8 0 0 0 12 21.5h1.6" />
      <path d="m12.4 19.4-1.6 2.1 2.2 1.4" />
    </svg>
    {line}
  </p>
  <button type="button" class="rotate__close" data-landscape-dismiss aria-label="Dismiss">
    Got it
  </button>
</div>

<script>
  /* Portrait phones only, once, and never in the way. */
  const KEY_PREFIX = 'axis-mundi-landscape-';
  for (const el of document.querySelectorAll<HTMLElement>('[data-landscape-hint]')) {
    const room = el.dataset['landscapeHint'] ?? '';
    const key = KEY_PREFIX + room;

    let seen = false;
    try {
      seen = localStorage.getItem(key) === 'seen';
    } catch {
      /* no storage; it greets them once more, which is not a failure */
    }
    if (seen) continue;

    /* Coarse pointer and portrait: a laptop in a narrow window is not a phone
       being held the wrong way round, and telling it to rotate is nonsense. */
    const phone = window.matchMedia('(pointer: coarse) and (orientation: portrait)');

    const dismiss = (): void => {
      el.hidden = true;
      phone.removeEventListener('change', sync);
      try {
        localStorage.setItem(key, 'seen');
      } catch {
        /* nothing to remember it with */
      }
    };

    function sync(): void {
      el.hidden = !phone.matches;
    }

    sync();
    /* Turning the phone is the reader taking the suggestion; the hint goes. */
    phone.addEventListener('change', () => {
      if (!phone.matches) dismiss();
      else sync();
    });
    el.querySelector('[data-landscape-dismiss]')?.addEventListener('click', dismiss);
  }
</script>

<style>
  .rotate {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--hairline-width) solid var(--hairline);
    background: var(--surface);
    color: var(--ink-soft);
  }

  .rotate__line {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-small);
    margin: 0;
  }

  .rotate__glyph {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The 44px floor and the brass focus ring both come from base.css. */
  .rotate__close {
    flex: none;
    padding: 0 var(--space-3);
    border: var(--hairline-width) solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    cursor: pointer;
  }
</style>
