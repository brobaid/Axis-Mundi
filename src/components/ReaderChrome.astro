---
import type { EditionLine, Mode } from '../lib/reader-model';

/**
 * The reader's shared furniture: the mode toggle and the edition line.
 *
 * Both appear on every text page, because the memo's rule is that each edition
 * is named on every page — the pairing is the claim, and a page that showed
 * only English would still owe the reader the Arabic it was translated from.
 */
interface Props {
  modes: readonly Mode[];
  mode: Mode;
  editions: readonly (EditionLine & { title: string; author?: string | undefined })[];
  /** Named absence for a canon that arrives with no English column. */
  englishPending?: string | undefined;
  /** Named absence for a canon that arrives with no original column. */
  originalPending?: string | undefined;
  /** Modes this canon cannot offer, and the one sentence saying why. */
  unavailable?: { modes: readonly Mode[]; reason: string } | undefined;
  /** Anything the work must state, e.g. a survival fraction. */
  note?: string | undefined;
}
const { modes, mode, editions, englishPending, originalPending, unavailable, note } = Astro.props;

const LABEL: Record<Mode, string> = {
  english: 'English',
  original: 'Original',
  both: 'Both',
};

/*
  Every mode the canon has, in the standing order, whether or not it works here.

  A disabled control is information and a missing one is not: the Avesta shows
  Original and Both greyed with the reason on them, because "there is no
  public-domain Avestan text to set beside this" is a fact about the world that
  a reader deserves, and an absent button says only that the page has one
  column. Disabled rather than hidden, and never clickable.
*/
const off = new Set<Mode>(unavailable?.modes ?? []);
const shown: Mode[] = modes.length > 1 || off.size > 0 ? ['english', 'original', 'both'] : [];
---

{
  shown.length > 0 && (
    <div class="rd-toggle" role="radiogroup" aria-label="Reading mode" data-reader-toggle>
      {shown.map((m) => (
        <button
          type="button"
          class="rd-toggle__btn"
          data-mode={m}
          role="radio"
          aria-checked={m === mode}
          aria-disabled={off.has(m) ? 'true' : undefined}
          disabled={off.has(m) || undefined}
          title={off.has(m) ? unavailable?.reason : undefined}
          tabindex={m === mode ? 0 : -1}
        >
          {LABEL[m]}
        </button>
      ))}
    </div>
  )
}

<p class="rd-edition caption">
  {
    editions.map((e, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        <span>
          {e.author === undefined ? e.title : `${e.title}, ${e.author}`}
          {e.note !== undefined && <span class="rd-edition__note"> — {e.note}</span>}
        </span>
      </>
    ))
  }
  {englishPending !== undefined && <span class="rd-edition__pending"> {englishPending}</span>}
  {originalPending !== undefined && <span class="rd-edition__pending"> {originalPending}</span>}
  {note !== undefined && <span class="rd-edition__work"> {note}</span>}
</p>

<style is:global>
  .rd-toggle {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .rd-toggle__btn {
    padding: 0 var(--space-4);
    border: var(--hairline-width) solid var(--hairline);
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: var(--size-small);
    cursor: pointer;
  }

  .rd-toggle__btn[aria-checked='true'] {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--surface);
  }

  /* Present, legible, and plainly not for pressing. Kept above the 3:1 the
     non-text contrast rule asks of a control that still has to be read. */
  .rd-toggle__btn:disabled {
    cursor: not-allowed;
    border-style: dashed;
    opacity: 0.72;
  }

  .rd-edition {
    color: var(--ink-soft);
    max-width: 42rem;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .rd-edition__pending,
  .rd-edition__work {
    display: block;
    margin-top: var(--space-2);
  }

  /* The toggle is a control, not content: it has no meaning on paper. */
  @media print {
    .rd-toggle {
      display: none;
    }
  }
</style>
