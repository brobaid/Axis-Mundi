---
import TraditionSymbols from './TraditionSymbols.astro';
import {
  buildLanes,
  layoutTimeline,
  zoomLabel,
  type TaxonomyNode,
  type TimelineEvent,
  type Viewport,
} from '../lib/timeline-model';
import { renderCanvas } from '../lib/timeline-render';

/**
 * The timeline canvas (M1).
 *
 * Server-renders the default view with the same model and renderer the island
 * uses, so the first paint is real content rather than a placeholder, and a
 * reader without JavaScript still gets the canvas plus the full chronological
 * list alternative that design language §10 requires.
 */

interface Props {
  events: TimelineEvent[];
  taxonomy: TaxonomyNode[];
  from: number;
  to: number;
  boundsFrom: number;
  boundsTo: number;
}

const { events, taxonomy, from, to, boundsFrom, boundsTo } = Astro.props;

/* Server render assumes the desktop track width; the island corrects to the
   real measurement on hydration. */
const view: Viewport = { from, to, width: 748 };
const lanes = buildLanes(taxonomy, '');
const layouts = layoutTimeline(lanes, events, [], view);

const canvasHtml = renderCanvas(layouts, view, {
  title: 'The World Timeline',
  subtitle: `${Math.abs(from)} ${from < 0 ? 'BCE' : 'CE'} – ${to} CE`,
  meridianYear: (from + to) / 2,
  meridianLabel: `${Math.round((from + to) / 2)} CE`,
});

/* Filter chips: the event types actually present, in spec §3.1 order. */
const TYPE_ORDER = [
  'founding', 'schism', 'text', 'figure', 'council', 'political',
  'reform', 'expansion', 'persecution', 'construction', 'encounter', 'modern',
];
const presentTypes = TYPE_ORDER.filter((t) => events.some((e) => e.type === t));

const chronological = [...events].sort(
  (a, b) => a.year_start - b.year_start || a.title.localeCompare(b.title),
);

const bootstrap = {
  events,
  taxonomy,
  bounds: { from: boundsFrom, to: boundsTo },
  defaultView: { from, to },
  types: presentTypes,
};
---

<TraditionSymbols />

<section class="tl" data-timeline aria-label="Interactive timeline">
  <!-- controls ------------------------------------------------------- -->
  <div class="tl-bar">
    <nav class="tl-crumb" data-crumb aria-label="Drill path">
      <b>World</b>
    </nav>
    <div class="tl-bar__actions">
      <button type="button" class="tl-btn" data-up hidden>Back up</button>
      <button type="button" class="tl-btn" data-ghost-toggle aria-pressed="false" hidden>
        Ghost mode
      </button>
      <button type="button" class="tl-btn" data-threads-toggle aria-pressed="false">
        Influence threads
      </button>
      <!--
        Explicit zoom, because the gestures that zoom on a desktop do not exist
        under a thumb: pinch belongs to the browser and double-tap has been
        given back to it. A phone reader had no way to change the span at all.
      -->
      <!--
        The stepper names the level it is stepping between, so changing scale is
        a thing the reader does on purpose rather than something that happens to
        them mid-scrub.
      -->
      <span class="tl-zoomer" role="group" aria-label="Scale">
        <button type="button" class="tl-btn tl-btn--icon" data-zoom-out aria-label="Wider scale">&minus;</button>
        <span class="tl-zoomer__level mono" data-zoom-label>{zoomLabel(to - from)}</span>
        <button type="button" class="tl-btn tl-btn--icon" data-zoom-in aria-label="Closer scale">+</button>
      </span>
      <p class="visually-hidden" data-tl-readout aria-live="polite"></p>
    </div>
  </div>

  <div class="tl-filters" role="group" aria-label="Filter by event type">
    <button type="button" class="tl-chip" data-type="" aria-pressed="true">All types</button>
    {
      presentTypes.map((t) => (
        <button type="button" class="tl-chip" data-type={t} aria-pressed="false">
          {t[0]?.toUpperCase()}{t.slice(1)}
        </button>
      ))
    }
  </div>

  <!--
    The scale bar's own label. It sits with the ruler rather than up in the
    controls, because it names what a tick means: a reader looking at the axis
    should not have to look away to find out what it is counting in.
  -->
  <p class="tl-scale">
    <span class="eyebrow">Scale</span>
    <b class="mono" data-scale-level>{zoomLabel(to - from)}</b>
    <span class="tl-scale__span mono" data-scale-span></span>
  </p>

  <!-- canvas --------------------------------------------------------- -->
  <div class="tl-frame" data-scroll tabindex="0" role="region" aria-label="Timeline canvas, scrollable">
    <div class="tl-canvas" data-canvas set:html={canvasHtml} />
  </div>

  <p class="tl-note caption">
    Dot size encodes importance rank; labels go to the most significant events that fit.
    Open any event without losing your place. Select a tradition to split it into branch lanes.
    <span class="tl-note__fine">Zoom with <kbd>ctrl</kbd> or <kbd>⌥</kbd> and scroll.</span>
    <span class="tl-note__coarse">Drag the canvas sideways to travel; the &minus; and + buttons change the
    span. Pinch and double tap belong to the page, so they zoom the page.</span>
  </p>

  <!--
    First visit only. Three lines, in the house voice, and then never again.

    It uses localStorage, which the design language bans for core reading paths
    — this is not one. Every word the coach says is true of the room whether or
    not the coach ever appeared, and with storage unavailable it simply shows
    each visit rather than breaking anything.
  -->
  <div class="tl-coach" data-tl-coach hidden>
    <div class="tl-coach__card" role="dialog" aria-labelledby="coach-title" aria-modal="false">
      <p class="eyebrow" id="coach-title">Reading this room</p>
      <ol role="list">
        <li>Scroll sideways to travel through time.</li>
        <li>Change the scale with the &minus; and + stepper, or pinch.</li>
        <li>Tap a dot to read the event; tap a ringed count to open that range.</li>
      </ol>
      <button type="button" class="tl-btn" data-coach-dismiss>Begin</button>
    </div>
  </div>

  <!-- accessible alternative ----------------------------------------- -->
  <details class="tl-list">
    <summary>Timeline as a list ({chronological.length} events)</summary>
    <ol>
      {
        chronological.map((e) => (
          <li>
            <span class="mono tl-list__date">{e.display_date}</span>
            <span class="tl-list__title">{e.title}</span>
            <span class="caption">{e.traditions.join(', ')} · rank {e.importance}</span>
            {e.contested && <span class="contested-badge">Contested</span>}
            <p class="caption tl-list__summary" set:html={e.summary_html ?? e.summary} />
          </li>
        ))
      }
    </ol>
  </details>

  <!-- event panel ---------------------------------------------------- -->
  <div class="tl-scrim" data-scrim hidden></div>
  <aside
    class="tl-panel"
    data-panel
    hidden
    role="dialog"
    aria-modal="false"
    aria-labelledby="tl-panel-title"
  >
  </aside>
</section>

<script type="application/json" id="timeline-data" set:html={JSON.stringify(bootstrap)} is:inline />

<script>
  import '../scripts/timeline';
</script>

<style>
  .tl {
    position: relative;
  }

  /* --- controls --------------------------------------------------------- */

  .tl-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 2px var(--space-3);
    flex-wrap: wrap;
  }

  .tl-crumb {
    font-family: var(--font-ui);
    font-size: var(--size-caption);
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tl-crumb :global(b) {
    color: var(--ink);
    font-weight: 600;
  }

  /* A drill step is a control, not prose: "World" was a 33x21 target. It gets
     the full tap height and horizontal padding, and inline-flex keeps the label
     centred so the crumb still reads as one line. */
  .tl-crumb :global(button) {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0 var(--space-2);
    min-height: var(--tap-min);
    font: inherit;
    color: var(--brass-ink);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .tl-crumb :global(.tl-crumb__sep) {
    color: var(--ink-soft);
  }

  .tl-bar__actions {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
    align-items: center;
  }

  .tl-zoom {
    white-space: nowrap;
  }

  .tl-zoomer {
    display: inline-flex;
    gap: var(--space-1);
  }

  /* --- first-visit coach ------------------------------------------------- */

  .tl-coach {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    place-items: end center;
    padding: var(--space-6) var(--space-4);
    background: var(--scrim);
  }

  .tl-coach__card {
    width: min(30rem, 100%);
    background: var(--surface);
    border: var(--hairline-width) solid var(--ink);
    box-shadow: var(--shadow-panel);
    padding: var(--space-6);
  }

  .tl-coach__card ol {
    margin: var(--space-3) 0 var(--space-4);
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-2);
  }

  .tl-coach__card li {
    font-size: var(--size-small);
  }

  @media (min-width: 48rem) {
    .tl-coach {
      place-items: center;
    }
  }

  /* The cluster sheet's list: every event the cluster stands for, reachable
     without moving the canvas. */
  .tl-panel :global(.tl-cluster-list) {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0;
    border-top: var(--hairline-width) solid var(--hairline);
  }

  .tl-panel :global(.tl-cluster-item) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-2) 0;
    border: 0;
    border-bottom: var(--hairline-width) solid var(--hairline);
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .tl-panel :global(.tl-cluster-item b) {
    font-weight: 500;
    color: var(--brass-ink);
  }

  .tl-panel :global(.tl-cluster-item i) {
    font-style: normal;
    flex: 0 0 auto;
    font-size: var(--size-caption);
    color: var(--ink-soft);
  }

  .tl-zoomer__level {
    display: inline-flex;
    align-items: center;
    min-width: 8ch;
    justify-content: center;
    font-size: 12px;
    color: var(--ink-soft);
  }

  /* The scale bar's label, on the rule above the ruler. */
  .tl-scale {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0 2px var(--space-2);
  }

  .tl-scale b {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .tl-scale__span {
    font-size: var(--size-caption);
    color: var(--ink-soft);
  }

  .tl-btn--icon {
    min-width: var(--tap-min);
    padding: 0;
    font-size: 18px;
    line-height: 1;
  }

  /* The note tells the truth for the pointer in the reader's hand: a phone has
     no ctrl key, and a desktop has no thumb. */
  .tl-note__coarse {
    display: none;
  }

  @media (pointer: coarse) {
    .tl-note__fine {
      display: none;
    }

    .tl-note__coarse {
      display: inline;
    }

    /* Thumb zone. The controls sat above the canvas, which meant reaching the
       top of a phone screen — or scrolling back up to it — every time a reader
       wanted ghost mode or threads. They dock to the bottom edge instead, where
       a thumb already rests, and the section reserves the height so nothing is
       permanently underneath them. */
    .tl-bar__actions {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: var(--z-sheet);
      margin-left: 0;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      background: var(--surface);
      border-top: var(--hairline-width) solid var(--hairline-strong);
      box-shadow: var(--shadow-sheet);
      /* Clear of the home indicator on a notched phone. */
      padding-bottom: max(var(--space-2), env(safe-area-inset-bottom));
    }

    /* The zoom label is desktop shorthand; the dock has no room for it and the
       readout already announces the span. */
    .tl-zoom {
      display: none;
    }

    /* A sheet and a dock must never stack. When the panel is open the dock
       stands down — the sheet carries its own close. */
    body:has([data-panel]:not([hidden])) .tl-bar__actions {
      display: none;
    }
  }

  .tl-btn {
    border: var(--hairline-width) solid var(--hairline-strong);
    background: var(--surface);
    border-radius: 6px;
    padding: 0 12px;
    min-height: var(--tap-min);
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) {
    .tl-btn:hover {
      border-color: var(--brass);
      color: var(--ink);
    }
  }

  .tl-btn[aria-pressed='true'] {
    border-color: var(--brass);
    color: var(--brass-ink);
  }

  .tl-filters {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 0 2px var(--space-3);
    scrollbar-width: thin;
  }

  .tl-chip {
    flex: 0 0 auto;
    border: var(--hairline-width) solid var(--hairline-strong);
    background: var(--surface);
    border-radius: var(--radius-pill);
    padding: 0 12px;
    min-height: var(--tap-min);
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) {
    .tl-chip:hover {
      border-color: var(--brass);
    }
  }

  .tl-chip[aria-pressed='true'] {
    border-color: var(--brass);
    color: var(--brass-ink);
  }

  /* --- the vitrine ------------------------------------------------------ */

  .tl-frame {
    position: relative;
    border: var(--hairline-width) solid var(--ink);
    box-shadow:
      0 0 0 3px var(--canvas),
      0 0 0 4px var(--hairline);
    background: var(--surface);
    overflow-x: auto;
    scrollbar-width: thin;
    touch-action: pan-y pinch-zoom;
  }

  .tl-canvas :global(.tl-inner) {
    position: relative;
    min-width: 880px;
    padding: 0 0 6px;
  }

  /* --- title plate ------------------------------------------------------ */

  .tl-canvas :global(.tl-plate-row) {
    display: flex;
    align-items: center;
    padding: 12px;
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .tl-canvas :global(.tl-plate) {
    position: sticky;
    left: 12px;
    background: var(--surface);
    border: var(--hairline-width) solid var(--ink);
    box-shadow:
      0 0 0 3px var(--surface),
      0 0 0 4px var(--ink);
    padding: 6px 13px 5px;
    margin: 4px 0 4px 4px;
    z-index: 5;
  }

  .tl-canvas :global(.tl-plate__title) {
    font-family: var(--font-display);
    font-size: 12.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .tl-canvas :global(.tl-plate__sub) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--brass-ink);
  }

  /* --- ruler ------------------------------------------------------------ */

  .tl-canvas :global(.tl-ruler) {
    position: relative;
    margin-left: 132px;
    height: 34px;
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  /* Both the morph's shift and the element's own placement live here, so the
     two compose rather than one clobbering the other. */
  .tl-canvas :global([data-morph-key]) {
    transform: var(--morph-shift, translate(0, 0)) var(--tick-align, translate(0, 0));
  }

  .tl-canvas :global(.tl-tick) {
    position: absolute;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* --- lanes ------------------------------------------------------------ */

  /* The threads overlay is absolutely positioned against the lanes block, so
     the lanes block has to be the containing block. Without this it resolved
     against .tl-inner and the arcs sat a gutter to the right and a plate-height
     too high — drawn, but not on the dots they join. */
  .tl-canvas :global(.tl-lanes) {
    position: relative;
  }

  /* Influence threads: a brass hairline, the same accent the meridian uses,
     because a thread is a relation the record already states rather than a new
     claim. Never a tradition hue — a thread belongs to no single lane. */
  .tl-canvas :global(.tl-threads) {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .tl-canvas :global(.tl-thread) {
    fill: none;
    stroke: var(--brass);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
    pointer-events: none;
  }

  .tl-canvas :global(.tl-thread__hit) {
    fill: none;
    stroke: transparent;
    stroke-width: 20;
    vector-effect: non-scaling-stroke;
    pointer-events: stroke;
    cursor: pointer;
  }

  .tl-canvas :global(.tl-thread__hit:focus-visible + .tl-thread) {
    opacity: 1;
    stroke-width: 2;
  }

  @media (hover: hover) {
    .tl-canvas :global(.tl-thread__hit:hover + .tl-thread) {
      opacity: 1;
      stroke-width: 2;
    }
  }

  /* One end sits on a cluster rather than a dot, so the thread says so. */
  .tl-canvas :global(.tl-thread--clustered) {
    stroke-dasharray: 4 3;
  }

  .tl-canvas :global(.tl-lane) {
    display: flex;
    align-items: center;
    height: 46px;
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .tl-canvas :global(.tl-lane:last-child) {
    border-bottom: 0;
  }

  @media (hover: hover) {
    .tl-canvas :global(.tl-lane:hover) {
      background: var(--lane-hover);
    }
  }

  .tl-canvas :global(.tl-lane__head) {
    position: relative;
    flex: 0 0 132px;
    /* A flex item's automatic minimum size is its content, which overrides the
       basis — so "Chinese traditions" widened its own rail to 148px and pushed
       that lane's whole track 16px right of the other nine. On a world view
       that is forty-four years: the same year did not sit at the same x, which
       is the one promise a comparative timeline makes. */
    min-width: 0;
    /* Every pixel of the rail is budgeted: 132 total, less padding, symbol,
       gap and the chevron's reserve, leaves 84 for the name. That is enough
       for "Zoroastrianism" on one line at this size and one pixel short for
       "Chinese traditions", which wraps at its space — which is the difference
       between a name that breaks mid-word and one that reads. */
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    font-weight: 500;
    position: sticky;
    left: 0;
    background: var(--surface);
    z-index: 2;
    height: 100%;
    min-height: 0;
    border-right: var(--hairline-width) solid var(--hairline);
    border-top: 0;
    border-bottom: 0;
    border-left: 0;
    color: var(--ink);
    text-align: left;
  }

  .tl-canvas :global(button.tl-lane__head) {
    cursor: pointer;
  }

  @media (hover: hover) {
    .tl-canvas :global(button.tl-lane__head:hover .tl-lane__name) {
      color: var(--brass-ink);
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
  }

  /* Two lines rather than an ellipsis: the rail is fixed, so a long name wraps
     inside it instead of stretching it. Fixed leading keeps a two-line name on
     the same rhythm as its one-line siblings, and the block centres so every
     lane's label sits on the same axis. */
  /* The chevron says the lane opens; it sits at the rail's edge so all ten
     read as a column of doors, and only the ones that are doors have it. */
  /* Out of flow, at the rail's edge. In flow it took twenty pixels from the
     name, which is what forced "Zoroastrianism" to break mid-word — and a
     lane label reading "Zoroastrianis / m" is worse than the ellipsis it
     replaced. The name reserves the space with padding instead, so nothing
     overlaps and every one of the ten fits on a line. */
  /* The contested hatch is also a right-edge mark, so on a lane that carries
     both they stack rather than collide: hatch inboard, chevron at the edge. */
  .tl-canvas :global(.tl-lane__head:has(.tl-lane__contested) .tl-lane__contested) {
    position: absolute;
    right: 18px;
    top: 50%;
    translate: 0 -50%;
  }

  .tl-canvas :global(.tl-lane__head:has(.tl-lane__contested) .tl-lane__name) {
    padding-right: 26px;
  }

  .tl-canvas :global(.tl-lane__chev) {
    position: absolute;
    right: 6px;
    top: 50%;
    translate: 0 -50%;
    font-size: 15px;
    line-height: 1;
    color: var(--ink-soft);
  }

  .tl-canvas :global(.tl-lane__name) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    white-space: normal;
    line-height: 1.25;
    /* "Chinese traditions" wraps at its space. "Zoroastrianism" has no space,
       so it hyphenates rather than being clipped — the rail is fixed and the
       name has to fit inside it, not the other way round. */
    /* Wrapping stays available for a name longer than the rail; none of the
       ten needs it today, and a word is never broken to force it. */
    overflow-wrap: normal;
    padding-right: 10px;
    font-size: 12px;
  }

  /* The contested hatch, same drafting convention as the badge and the map. */
  .tl-canvas :global(.tl-lane__contested) {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border: var(--hairline-width) solid var(--hairline-strong);
    background-image: repeating-linear-gradient(
      var(--hatch-angle),
      transparent 0,
      transparent 2px,
      var(--contested-hatch) 2px,
      var(--contested-hatch) 3px
    );
  }

  .tl-canvas :global(.tl-track) {
    position: relative;
    flex: 1;
    height: 100%;
    background: repeating-linear-gradient(
      to right,
      transparent 0 calc(100% / 12 - 1px),
      var(--hairline) calc(100% / 12 - 1px) calc(100% / 12)
    );
  }

  /* --- event nodes ------------------------------------------------------ */

  .tl-canvas :global(.tl-node) {
    position: absolute;
    transform: translate(-50%, -50%);
    width: var(--tap-min);
    height: var(--tap-min);
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .tl-canvas :global(.tl-node--r5) {
    z-index: 2;
  }

  .tl-canvas :global(.tl-dot) {
    display: block;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--tradition-hue);
  }

  .tl-canvas :global(.tl-node--r5 .tl-dot) {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tradition-hue) 20%, transparent);
  }

