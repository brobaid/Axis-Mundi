---
import ModeToggle from './ModeToggle.astro';
import Search from './Search.astro';
import { getPublishable } from '../lib/content';

/**
 * Global top bar (design language §8): wordmark, search, mode toggle.
 * Universal search lands in M2; the slot is held but not faked.
 */

/* The deep dives that this build actually publishes. Linking to a gated one
   would be a 404 in production, so the nav entry appears only when there is
   somewhere for it to go. */
const dives = await getPublishable('deepDives');
const firstDive = dives[0]?.data.tradition;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const isCurrent = (href: string): 'page' | undefined => (path === href ? 'page' : undefined);
---

<header class="topbar">
  <div class="shell topbar__inner">
    <a class="wordmark" href="/">
      <span class="wordmark__name">Axis Mundi</span>
      <span class="wordmark__sub eyebrow">The Living Museum</span>
    </a>
    <nav class="topbar__nav" aria-label="Rooms">
      <a class="tap" href="/timeline" aria-current={isCurrent('/timeline')}>Timeline</a>
      <a class="tap" href="/map" aria-current={isCurrent('/map')}>Map</a>
      {
        firstDive && (
          <a class="tap" href={`/traditions/${firstDive}`} aria-current={isCurrent(`/traditions/${firstDive}`)}>
            Traditions
          </a>
        )
      }
    </nav>
    <div class="topbar__tools">
      <Search />
      <ModeToggle />
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    background: var(--canvas);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding-block: var(--space-2);
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    text-decoration: none;
    color: var(--ink);
    min-height: var(--tap-min);
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .wordmark__sub {
    color: var(--ink-soft);
  }

  .topbar__nav {
    margin-left: auto;
    margin-right: var(--space-4);
    display: flex;
    gap: var(--space-4);
  }

  .topbar__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* At 390px the bar carries wordmark, two nav links, search and the mode
     toggle. The two labels that are recoverable elsewhere give up their width
     first: the wordmark subtitle, and the toggle's text (which keeps its
     aria-label and its filled/hollow dot). */
  @media (max-width: 30rem) {
    .topbar__nav {
      gap: var(--space-2);
      margin-right: var(--space-1);
      min-width: 0;
    }

    .topbar__nav a {
      letter-spacing: 0.04em;
    }

    .wordmark__sub {
      display: none;
    }

    .wordmark__name {
      white-space: nowrap;
      font-size: var(--size-body);
    }
  }

  .topbar__nav a {
    font-family: var(--font-ui);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .topbar__nav a:hover {
    color: var(--brass-ink);
  }

  .topbar__nav a[aria-current='page'] {
    color: var(--brass-ink);
  }
</style>
