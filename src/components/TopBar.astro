---
import ModeToggle from './ModeToggle.astro';
import RoomsNav from './RoomsNav.astro';
import Search from './Search.astro';

/**
 * Global top bar (design language §8): wordmark, search, mode toggle, and the
 * rooms rail beneath them.
 *
 * The rooms used to sit inline beside the wordmark. M4 takes the count to five,
 * which does not fit at 390px next to search and the toggle, so they moved to
 * their own scrolling row — the shape the reference build uses. Both rows are
 * inside the one sticky element, so nothing has to know the header's height.
 */

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="topbar">
  <div class="shell topbar__inner">
    <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="wordmark__name">Axis Mundi</span>
      <span class="wordmark__sub eyebrow">The Living Museum</span>
    </a>
    <div class="topbar__tools">
      <Search />
      <ModeToggle />
    </div>
  </div>
  <div class="shell">
    <RoomsNav />
  </div>
</header>

<script>
  /**
   * Keep `scroll-padding-top` equal to the sticky bar's real height.
   *
   * The bar is two rows of type, so its height follows the type scale rather
   * than any number we could write down. Measuring it means an anchor can never
   * land underneath it, whatever the fonts do.
   */
  const bar = document.querySelector<HTMLElement>('.topbar');
  if (bar !== null) {
    const sync = (): void => {
      document.documentElement.style.scrollPaddingTop = `${Math.ceil(bar.getBoundingClientRect().height) + 12}px`;
    };
    sync();
    new ResizeObserver(sync).observe(bar);
  }
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    background: var(--canvas);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding-block: var(--space-2);
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    text-decoration: none;
    color: var(--ink);
    min-height: var(--tap-min);
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: var(--size-h3);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
  }

  .wordmark__sub {
    color: var(--ink-soft);
  }

  .topbar__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  /* At 390px the first row carries the wordmark, search and the mode toggle.
     The subtitle is the one label recoverable elsewhere, so it gives up its
     width first; the toggle drops its own text separately and keeps its
     aria-label and its filled/hollow dot. */
  @media (max-width: 30rem) {
    .wordmark__sub {
      display: none;
    }

    .wordmark__name {
      white-space: nowrap;
      font-size: var(--size-body);
    }
  }
</style>
