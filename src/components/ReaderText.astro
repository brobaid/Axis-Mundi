---
import ReaderChrome from './ReaderChrome.astro';
import ParallelColumns from './ParallelColumns.astro';
import DevotionalToggle from './DevotionalToggle.astro';
import DivisionJump from './DivisionJump.astro';
import {
  carries,
  defaultMode,
  hasEnglish,
  divisionGloss,
  gapNote,
  langTag,
  originalLang,
  pageModes,
  parallelCounts,
  prefaceFor,
  unavailableModes,
  sectionOf,
  sidesOf,
  verseAnchor,
  verseRange,
  verseRef,
  walk,
  type EditionLine,
  type ParallelBlock,
  type VerseRow,
  type WorkData,
  type DivisionIndex,
} from '../lib/reader-model';
import { fontFor } from '../lib/scripts';
import { conventionFor } from '../lib/devotional';

/**
 * The reading page — Phase 5.
 *
 * One component for both leaf routes, because they are the same page: a surah
 * runs straight to its ayat and a chapter of a book is one level further down,
 * but what a reader gets is a numbered text in one or two columns either way.
 * Two copies of this markup would be two chances for the two canons to drift.
 */
interface Props {
  work: WorkData;
  division: DivisionIndex;
  /** Absent where the division is itself the leaf. */
  chapter?: number | undefined;
  verses: readonly VerseRow[];
  /** Present instead of verses where this division's editions do not align. */
  parallel?: ParallelBlock | undefined;
  /** What the page calls itself: "Genesis 1", "Surah 2". */
  heading: string;
  /** The trail above the heading, innermost last. */
  crumbs: readonly { href: string; label: string }[];
  editions: readonly (EditionLine & { title: string; author?: string | undefined })[];
}
const { work, division, chapter, verses, parallel, heading, crumbs, editions } = Astro.props;

/* An unversified canon's division is one block and the citable unit both:
   nobody cites Daodejing 12 verse 3, so no numeral is imposed on it. */
const versified = work.versified !== false;

/*
  How much text is here, in the unit this division actually has.

  Three shapes, three answers. A versified division counts verses. A parallel
  one counts twice, in the words each column counts in, because a single number
  there would be the very claim the columns exist to refuse. An unversified one
  has no sub-count to give at all — "1 verses" was both ungrammatical and a
  claim about a division the Daodejing does not make — so the line goes.
*/
const count = [
  division.parallel !== undefined
    ? parallelCounts(division.parallel)
    : versified
      ? `${verses.length} verses`
      : '',
  chapter === undefined ? (verseRange(division) ?? '') : '',
  division.transliteration ?? '',
]
  .filter((part) => part !== '')
  .join(' · ');

/* This chapter's own index entry, for what the record alone cannot say. */
const here = chapter === undefined ? undefined : division.chapters?.find((c) => c.c === chapter);
/* The stratum this chapter belongs to, where it belongs to one. */
const badge = here?.badge;

/*
  Whether a missing column here is a gap or simply this page's shape.

  Both happen. An Old Testament page carries no Greek by ruling and says so in
  its section note, and flagging every chapter of it would be noise. A Rigveda
  hymn Griffith declined to translate is a hole in the pairing and has to say
  so where a reader meets it. The index already tells the two apart: gaps are
  counted at ingestion against the columns a division actually carries, so the
  Old Testament reports none and Rigveda 8.95 reports one.
*/
const gapped = (here?.english_gaps ?? 0) + (here?.original_gaps ?? 0) > 0;

const orig = originalLang(work);
/*
  What this page can show, not what the work can. An Old Testament page carries
  no Greek — its Hebrew is in the Tanakh room — so it offers English alone
  rather than a toggle onto an empty column.
*/
const modes = pageModes(work, verses);
const mode = modes.includes(defaultMode(work)) ? defaultMode(work) : (modes[0] ?? 'english');
/* A missing original is a gap only where the page otherwise has one. */
const english = hasEnglish(work) && (carries(verses, 'en') || gapped);
const hasOriginal = orig !== '' && (carries(verses, orig) || gapped);
const scriptFont = fontFor(work.script);
const { prev, next, endsSection } = walk(work, division, chapter);
const { line: preface, omittedNote } = prefaceFor(work, division, chapter);
const section = sectionOf(work, division.n);
const convention = conventionFor(work.tradition);
/* A jump control rather than a list, where a list would be unusable. The
   threshold is where a select stops fitting on a phone screen and starts being
   a scroll of its own. */
const manyDivisions = chapter === undefined && work.divisions.length > 120;

const contentsHref =
  chapter === undefined ? `/read/${work.id}` : `/read/${work.id}/${division.slug}`;
const contentsLabel =
  chapter === undefined
    ? `All ${work.divisions.length} ${work.division_label_plural}`
    : `All ${division.chapters?.length ?? 0} ${work.chapter_label ?? 'chapter'}s of ${
        division.name ?? division.slug
      }`;
---

<article
  class="shell rd"
  data-reader
  data-work={work.id}
  data-division={chapter === undefined ? division.slug : `${division.slug}/${chapter}`}
  data-heading={heading}
  data-parallel={parallel === undefined ? undefined : 'yes'}
>
  <header class="rd__head">
    <p class="eyebrow">
      {
        crumbs.map((crumb, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a class="tap" href={crumb.href}>
              {crumb.label}
            </a>
          </>
        ))
      }
    </p>
    <h1 class="rd__title">
      {heading}
      {
        chapter === undefined && division.name_original !== undefined && (
          <span
            class="rd__title-original"
            lang={langTag(work, orig)}
            dir={work.direction}
            style={`font-family: ${scriptFont}`}
          >
            {division.name_original}
          </span>
        )
      }
      {/* The canon's name leads; what it means follows it. */}
      {
        chapter === undefined && divisionGloss(division) !== undefined && (
          <span class="rd__title-gloss">{divisionGloss(division)}</span>
        )
      }
    </h1>
    {
      /* And on the page itself, not only on the contents row a reader may
         never have passed through: a link into Yasna 28 lands here, and this
         is where "the oldest stratum" has to be sayable. */
      badge !== undefined && (
        <p class="rd__badges">
          <span class="rd-badge" title={badge.title}>{badge.label}</span>
        </p>
      )
    }
    {count !== '' && <p class="caption rd__count">{count}</p>}
  </header>

  <ReaderChrome
    modes={modes}
    mode={mode}
    editions={editions}
    englishPending={work.english_pending}
    originalPending={work.original_pending}
    unavailable={unavailableModes(work)}
    note={work.note}
  />

  {/* A fact that is true of every page in a section belongs on every page in
      it, not only on a contents page nobody has to pass through. */}
  {section?.note !== undefined && <p class="caption rd__section-note">{section.note}</p>}

  {/* The mode is an attribute on this container, resolved in CSS against the
      modes this work can actually offer, so a stored preference a corpus
      cannot honour falls back to the work's own default. */}
  <DevotionalToggle tradition={work.tradition} />

  {/*
    The opening line the canon's own convention puts above verse 1.

    Fidelity, not a preference, so there is no toggle: the mushaf opens every
    surah but at-Tawba with the basmala, and in all but al-Fatiha it stands
    above the numbering rather than inside it. Both scripts, lifted from the
    corpus — surah 1 carries it as its own first verse — so the words and the
    editions are the ones already named on this page.
  */}
  {
    preface !== undefined && (
      <p class="rd-preface" data-preface>
        <span class="rd-preface__orig" lang={langTag(work, orig)} dir={work.direction}
              style={`font-family: ${scriptFont}`}>
          {preface.text[orig]}
        </span>
        {preface.text['en'] !== undefined && (
          <span class="rd-preface__en">{preface.text['en']}</span>
        )}
      </p>
    )
  }
  {omittedNote !== undefined && <p class="caption rd-preface__absent">{omittedNote}</p>}

  {
    /* A division whose editions do not align renders as columns instead: no
       verse list, no pairing, and the note above them saying why. */
    parallel !== undefined ? (
      <ParallelColumns work={work} block={parallel} heading={heading} />
    ) : (
  <div
    class="rd-verses"
    data-modes={modes.join(' ')}
    data-default={mode}
    data-script={work.script}
    data-direction={work.direction}
    data-versified={versified ? 'yes' : 'no'}
    style={`--script-font: ${scriptFont}`}
  >
    {
      verses.map((verse) => {
        /*
          A verse stands on both sides, on one, or on none. All three happen in
          this room: the Tanakh's versification diverges either way, the New
          Testament's critical Greek omits verses the traditional text carries,
          and five of those the English omits too — a number in the numbering
          with no words behind it in any edition here.
        */
        const sides = hasOriginal ? sidesOf(verse, orig, english) : 'both';
        const note = gapNote(work, sides);
        return (
          <div class="rd-verse" id={verseAnchor(verse)}>
            {/* No numeral where the canon has no verse level: the chapter is
                the citable unit and its own address is the citation. */}
            {versified && (
              <a
                class="rd-verse__n"
                href={`#${verseAnchor(verse)}`}
                aria-label={`Verse ${verseRef(heading, verse)}`}
              >
                {verse.v}
              </a>
            )}
            {sides === 'neither' ? (
              /* One line, not two: a row that said "no English" and "no
                 original" under each other would be reporting one absence
                 twice and reading as a fault rather than as a fact. */
              <p class="rd-verse__gap rd-verse__gap--neither caption">{note}</p>
            ) : (
              <>
                {english && verse['en'] !== undefined && (
                  <p class="rd-verse__en">
                    {verse['en']}
                    {/* Chamberlain's footnote references, set as the references
                        they are. His notes are not in this digitisation, so they
                        point at nothing a reader can follow and must not look
                        like they do — no link, no target, just the marks he
                        left and a line saying what they are. */}
                    {Array.isArray(verse['marks']) && verse['marks'].length > 0 && (
                      <span
                        class="rd-verse__marks"
                        title="Footnote references from the translator; his notes are not in this digitisation."
                      >
                        {(verse['marks'] as number[]).join(', ')}
                      </span>
                    )}
                  </p>
                )}
                {sides === 'original-only' && <p class="rd-verse__gap caption">{note}</p>}
                {/* dir and lang live in the markup, never in CSS: the direction
                    a paragraph is set in decides where its punctuation lands,
                    and that must not depend on which column is showing. */}
                {verse[orig] !== undefined && (
                  <p class="rd-verse__orig" lang={langTag(work, orig)} dir={work.direction}>
                    {verse[orig]}
                  </p>
                )}
                {sides === 'english-only' && (
                  <p class="rd-verse__gap rd-verse__gap--orig caption" lang="en">
                    {note}
                  </p>
                )}
                {/* The waiting-on sentence is stated once, above the text, and
                    on the disabled toggles. It used to repeat under every verse
                    — twenty-three times on the Guru Granth Sahib's first ang and
                    seventy-five on its longest — because no original-only canon
                    had ever been built until this one. Once is the claim; the
                    rest was noise. */}
              </>
            )}
          </div>
        );
      })
    }
  </div>
    )
  }

  {/*
    The closing formula. Set apart from the verses above it in every way a page
    can manage — its own block, its own rule, its own label — because it is
    said after a recitation and is not part of the surah, and a reader must
    never be able to mistake one for the other.

    Shown only under the Devotional frame, and present in the DOM either way:
    the frame is a CSS switch, so turning it on cannot alter a word of what is
    above it.
  */}
  {
    convention.closing !== undefined && (
      <aside class="dv dv-closing" aria-label="Recitation formula">
        <p class="dv-closing__text" lang={convention.closing.lang} dir={convention.closing.direction}
           style={`font-family: ${scriptFont}`}>
          {convention.closing.text}
        </p>
        <p class="caption dv-closing__gloss">
          {convention.closing.translation}. {convention.closing.note}
        </p>
      </aside>
    )
  }

  <nav class="rd-nav" aria-label={`${heading}, neighbouring pages`}>
    {
      prev === undefined ? (
        <span />
      ) : (
        <a class="rd-nav__link" href={prev.href} rel="prev">
          <span aria-hidden="true">←</span> {prev.label}
        </a>
      )
    }

    {
      /* Past a certain length a select stops being a control and becomes a
         sixty-kilobyte list nobody can use. See DivisionJump. */
      manyDivisions ? (
        <DivisionJump work={work} current={division.n} />
      ) : (
    <label class="rd-jump">
      <span class="visually-hidden">Jump to a {work.chapter_label ?? work.division_label}</span>
      <select class="rd-jump__select" data-reader-jump>
        {
          chapter === undefined
            ? work.divisions.map((d) => (
                <option value={`/read/${work.id}/${d.slug}`} selected={d.slug === division.slug}>
                  {d.name ?? `${work.division_label} ${d.n}`}
                </option>
              ))
            : (division.chapters ?? []).map((ch) => (
                <option
                  value={`/read/${work.id}/${division.slug}/${ch.c}`}
                  selected={ch.c === chapter}
                >
                  {heading.replace(/ \d+$/, '')} {ch.c}
                </option>
              ))
        }
      </select>
    </label>
      )
    }

    {
      next === undefined ? (
        <span />
      ) : (
        <a class="rd-nav__link rd-nav__link--next" href={next.href} rel="next">
          {next.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </nav>

  {
    endsSection !== undefined && (
      <p class="caption rd__section-end">
        {heading} ends {endsSection.name}. The {work.division_label_plural} of the next section are
        on the <a class="tap" href={`/read/${work.id}`}>contents page</a>.
      </p>
    )
  }

  <p class="caption rd__contents-link">
    <a class="tap" href={contentsHref}>
      {contentsLabel}
    </a>
  </p>

  {/* Paper carries no edition line at the head of every sheet, and a printed
      page of scripture with nothing naming its editions is an unsourced page.
      Screen readers get it too — it is the same claim, not decoration. */}
  <footer class="rd-print-footer">
    {work.title} · {heading} ·{' '}
    {editions.map((e) => (e.author === undefined ? e.title : `${e.title}, ${e.author}`)).join(' · ')}
  </footer>
</article>

<script>
  import '../scripts/reader';
</script>

<style is:global>
  .rd {
    padding-block: var(--space-12) var(--space-16);
    max-width: 46rem;
  }

  /* 46rem is one column of prose at a readable measure. A parallel division
     puts two beside each other, and squeezing them into the single-column
     width gave each about sixteen Han characters per line — a measure narrow
     enough to break phrases. So the page widens to hold two of them, and only
     where there are two: everything else keeps the reading measure. */
  .rd[data-parallel] {
    max-width: 76rem;
  }

  /* The head still reads as prose, so it keeps the measure the widened page
     no longer sets. */
  .rd[data-parallel] .rd__head,
  .rd[data-parallel] .rd-edition,
  .rd[data-parallel] .rd-nav {
    max-width: 46rem;
  }

  .rd__head {
    margin-bottom: var(--space-6);
  }

  .rd__title {
    font-family: var(--font-display);
    font-size: var(--size-h1);
    line-height: 1.15;
  }

  .rd__title-original {
    margin-left: var(--space-4);
    color: var(--ink-soft);
  }

  /*
    Set apart by a slash and a lighter ink, at the same size: it is half of the
    heading, not a subtitle under it. "Yamakavagga / Pairs" is how the chapter
    is named, and neither half is the caption of the other.
  */
  .rd__title-gloss {
    color: var(--ink-soft);
  }

  .rd__title-gloss::before {
    content: ' / ';
  }

  .rd__section-note {
    color: var(--ink-soft);
    max-width: 42rem;
    margin-top: calc(-1 * var(--space-4));
    margin-bottom: var(--space-6);
  }

  .rd__badges {
    margin-top: var(--space-3);
  }

  /* The same mark the contents row carries, so the two read as one thing. */
  .rd-badge {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--size-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brass-ink);
    border: var(--hairline-width) solid var(--brass);
    padding: 0 var(--space-2);
    cursor: help;
  }

  .rd__count {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  /* --- chapters ---------------------------------------------------------- */

  .rd-chapter {
    font-family: var(--font-ui);
    font-size: var(--size-small);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--hairline-width) solid var(--hairline);
    scroll-margin-top: 9rem;
  }

  .rd-chapter-group:first-child .rd-chapter {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .rd-chapter__label {
    color: var(--ink-soft);
  }

  /* --- the text ---------------------------------------------------------- */

  /*
    A grid rather than a flex row around a wrapper div. The wrapper was one
    element per verse and this canon has twenty-three thousand of them, so it
    was worth removing: the numeral takes the first column and every part of
    the verse's body stacks in the second.
  */
  .rd-verse {
    display: grid;
    grid-template-columns: 3ch 1fr;
    column-gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--hairline-width) solid var(--hairline);
    /* An anchored verse must clear the sticky header; the global
       scroll-padding-top handles the page, this handles the element. */
    scroll-margin-top: 9rem;
  }

  .rd-verse > * {
    grid-column: 2;
  }

  /* An unversified canon has no numeral column to leave room for. */
  .rd-verses[data-versified='no'] .rd-verse {
    grid-template-columns: 1fr;
    border-bottom: none;
    padding-block: 0;
  }

  .rd-verses[data-versified='no'] .rd-verse > * {
    grid-column: 1;
  }

  .rd-verse:target {
    background: var(--surface);
    /* The brass rule marks where a shared link landed, and nothing else. */
    box-shadow: inset 3px 0 0 var(--brass);
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
  }

  /* The numeral is small by design and its target is not: the link stretches
     to the verse's own height, which on a one-line verse is the difference
     between a 29px target and a reachable one. */
  .rd-verse__n {
    grid-column: 1;
    grid-row: 1 / -1;
    min-height: var(--tap-min);
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    color: var(--ink-soft);
    text-decoration: none;
    padding-top: 0.35em;
  }

  .rd-verse__n:hover {
    color: var(--brass-ink);
  }

  /* Reading measure and leading, tuned for the Latin column. */
  .rd-verse__en {
    font-family: var(--font-prose);
    font-size: 1.0625rem;
    line-height: 1.72;
    max-width: 36rem;
  }

  /*
    The original is tuned independently, because it has to be. Naskh sets small
    against Latin at the same nominal size and carries diacritics above and
    below the line, so it wants both more size and more leading — matching the
    Latin numbers would give a cramped, unreadable block.
  */
  .rd-verse__orig {
    font-family: var(--script-font);
    font-size: 1.5rem;
    line-height: 2.15;
    max-width: 36rem;
    margin-top: var(--space-3);
  }

  /*
    Hebrew is pointed on both sides of the line here: cantillation above,
    vowel points below, sometimes three deep. The Masoretic text needs the
    leading more than it needs the size — Noto Serif Hebrew sets larger than
    Naskh at the same nominal size — so this takes size down and leading up.
  */
  .rd-verses[data-script='hebrew'] .rd-verse__orig {
    font-size: 1.375rem;
    line-height: 2.35;
  }

  /*
    Gurmukhi, set as lines rather than as prose.

    Lineation is part of how this scripture is read and cited, so each source
    line is its own row and nothing re-flows one into the next: the line breaks
    a reader sees are the ones the text has, not the ones the column width
    produced. A line too long for the measure wraps and is indented, so a wrap
    is visibly a wrap and never mistaken for the next line of the text.

    The size is for the signs. Vowels sit above and below — 40,850 EE, 29,136
    AI, 25,886 OO and 21,782 tippi above; 96,643 U and 13,514 UU below — and
    11,778 viramas subjoin a letter beneath its base, so the marks want both
    the size and the leading. Measured for clipping at 390px, the way the
    pointed Hebrew and the accented Devanagari were.
  */
  .rd-verses[data-script='gurmukhi'] .rd-verse__orig {
    font-family: var(--script-font);
    font-size: 1.45rem;
    line-height: 2.1;
    margin-top: 0;
    /* A wrapped line hangs, so the eye can tell a wrap from a line break. */
    padding-left: var(--space-6);
    text-indent: calc(-1 * var(--space-6));
  }

  /* Lines of one ang belong to one another: no gap between them, and the ang's
     own breath comes from the leading rather than from margins between lines. */
  .rd-verses[data-script='gurmukhi'] .rd-verse {
    padding-block: 0;
  }

  /*
    Devanagari carries the vedic tone accents, and they are the whole reason
    for the size.

    Udatta is a vertical stroke above the syllable — above the matra zone,
    which is already the tallest thing on the line — and anudatta a horizontal
    stroke below the baseline. There are 174,000 of them in this corpus, they
    are the difference between the samhita and a flattened text, and at the
    prose size they close up into the strokes around them. So: larger than the
    Latin column for legibility, and leading deep enough that neither mark
    collides with the line above or below. Measured for clipping at 390px, the
    way the pointed Hebrew was.
  */
  .rd-verses[data-script='devanagari'] .rd-verse__orig {
    font-size: 1.5rem;
    line-height: 2.4;
  }

  /*
    A Latin-script original is set at the Latin measure, because it is Latin:
    romanised Pali and polytonic Greek have the x-height and the counters the
    English column has, and the size above exists to compensate for scripts
    that do not. At 1.5rem beside a 1.0625rem translation they read as the
    headline of their own verse.

    Greek keeps a little more leading than English: the polytonic accents and
    breathings sit above the line and the Latin column's 1.72 crowds them.
  */
  .rd-verses[data-script='pali'] .rd-verse__orig,
  .rd-verses[data-script='latin'] .rd-verse__orig {
    font-size: 1.0625rem;
    line-height: 1.72;
  }

  .rd-verses[data-script='greek'] .rd-verse__orig {
    font-size: 1.0625rem;
    line-height: 1.9;
  }

  .rd-verse__pending,
  /* A reference, at reference size, out of the reading line. */
  .rd-verse__marks {
    font-family: var(--font-mono);
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    color: var(--ink-soft);
    margin-left: 0.35em;
    white-space: nowrap;
  }

  .rd-verse__gap {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  /* --- the opening line -------------------------------------------------- */

  /*
    Set as the mushaf sets it: centred above the numbered text, in the same
    face as the verses, with no verse number beside it — because it does not
    have one. The rule beneath separates it from verse 1 without making it a
    heading, which it is not either.
  */
  .rd-preface {
    text-align: center;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-2);
    border-bottom: var(--hairline-width) solid var(--hairline);
  }

  .rd-preface__orig {
    display: block;
    font-family: var(--script-font);
    font-size: 1.5rem;
