---
/* Self-hosted at build time (design language §4.1: "All available on Google
   Fonts; self-host at build"). Weight-axis variable files only — the optical
   and width axes are not used by the type scale, so they are not shipped.
   The Noto per-script faces are declared in tokens.css and imported when
   original-script content lands in M2; importing the CJK sets now would add
   megabytes for no current glyph. */
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
/* Arabic and Hebrew subsets. The remaining Noto script faces are imported as
   the traditions that need them land, so a reader never downloads a script the
   page does not use: a face is only fetched when an element on the page
   actually resolves to it, and only the reading rooms set these families.
   Hebrew arrives with the Tanakh — the Masoretic text carries cantillation
   above the line and vowel points below it, and the prose fallback draws
   neither, so the face is not a refinement here but the difference between a
   pointed text and a mangled one. */
import '@fontsource/noto-naskh-arabic/arabic-400.css';
import '@fontsource/noto-serif-hebrew/hebrew-400.css';
/* Latin Extended Additional, for romanised Pali.

   Source Serif 4 carries every Pali diacritic but one: ṁ, the niggahita, which
   is the most common of them — measured, it fell through to whatever serif the
   reader's machine happens to have, which is the thing self-hosting exists to
   prevent. This subset is fetched only where a page actually sets it. */
import '@fontsource/noto-serif/latin-ext-400.css';

import '../styles/tokens.css';
import '../styles/base.css';

import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /**
   * Keep this page out of the index and out of the canonical graph.
   *
   * For the 404 plate: a canonical link on an error page invites a crawler to
   * treat that error as a real destination, and the sitemap already says which
   * addresses exist.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title === 'Axis Mundi' ? title : `${title} — Axis Mundi`;

/* Canonical and social URLs are absolute against the configured site. The card
   is the Brass Meridian over the ten lanes — the site's own object, not a
   photograph: the design language bans stock religious imagery, and a social
   card is the one place that ban is easiest to forget.

   PNG, not the SVG it is drawn from: the crawlers that read og:image do not
   rasterise SVG, so an SVG card is a card nobody sees. social-card.svg stays
   in the repo as the editable source. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialCard = new URL('/social-card.png', Astro.site).href;
---

<!doctype html>
<html lang="en" data-mode="gallery">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Axis Mundi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Brass Meridian standing across ten timeline lanes, one per tradition." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialCard} />

    <!--
      Set the mode before first paint so there is no flash. Default is Gallery
      regardless of OS preference, as a product decision (design language §9).
    -->
    <script is:inline>
      (function () {
        var mode = 'gallery';
        try {
          var stored = localStorage.getItem('axis-mundi-mode');
          if (stored === 'gallery' || stored === 'night-gallery') mode = stored;
        } catch {
          /* storage unavailable; Gallery it is */
        }
        document.documentElement.dataset.mode = mode;
      })();
    </script>

    <!--
      The Reading Room's English/Original/Both preference, before first paint
      for the same reason. Reader pages switch on it in CSS, so the text is
      always in the DOM and reading never depends on storage — the attribute
      only chooses which column shows. A page declares which modes it offers,
      so a preference a corpus cannot honour simply does not match.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('axis-mundi-reading-mode');
          if (stored === 'english' || stored === 'original' || stored === 'both') {
            document.documentElement.dataset.readingMode = stored;
          }
        } catch {
          /* storage unavailable; each page keeps its own default */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
