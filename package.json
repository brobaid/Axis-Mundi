{
  "name": "axis-mundi",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Axis Mundi — an interactive comparative reference for ten religious traditions.",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:tokens": "tsx scripts/check-tokens.ts",
    "validate:timeline": "tsx scripts/check-timeline.ts",
    "validate": "npm run validate:content && npm run validate:tokens && npm run validate:timeline",
    "lint": "eslint . && astro check",
    "check": "npm run validate:install && npm run validate && npm run lint && npm run build && npm run validate:links && npm run validate:reader",
    "validate:links": "tsx scripts/check-links.ts",
    "ingest:corpus": "tsx scripts/ingest-corpus.ts",
    "validate:reader": "tsx scripts/check-reader.ts",
    "validate:install": "tsx scripts/check-install.ts"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.18.0",
    "@fontsource-variable/archivo": "^5.2.6",
    "@fontsource-variable/newsreader": "^5.2.6",
    "@fontsource-variable/source-serif-4": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/noto-naskh-arabic": "^5.2.5",
    "@fontsource/noto-sans-gurmukhi": "^5.2.5",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.2.5",
    "@fontsource/noto-serif-hebrew": "^5.2.5",
    "@fontsource/noto-serif-jp": "^5.2.5",
    "@fontsource/noto-serif-sc": "^5.2.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
